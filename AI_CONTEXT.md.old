MAX_OPPORTUNISTIC_ORDERS=5            # Max levels to fill at once
RECOVERY_EXECUTION_DELAY_MS=300       # Delay between orders
MIN_PROFIT_MARGIN_INR=500             # Minimum profit threshold
```

