def _unauthorized_response():
    response = jsonify({'error': 'Unauthorized'})
    response.status_code = 401
    response.headers['WWW-Authenticate'] = WWW_AUTHENTICATE_HEADER
    return response


def _has_bearer_access(req) -> bool:
    if not AUTH_TOKEN_ENABLED:
        return False
    auth_header = req.headers.get('Authorization')
    if not auth_header:
        return False
    scheme, _, token = auth_header.partition(' ')
    if scheme.lower() != 'bearer' or not token:
        return False
    try:
        return hmac.compare_digest(token.strip(), WEBUI_AUTH_TOKEN)
    except Exception:
        return False


def _has_basic_access(req) -> bool:
    if not AUTH_BASIC_ENABLED:
        return False
    creds = req.authorization
    if not creds or not creds.username or not creds.password:
        return False
    try:
        user_ok = hmac.compare_digest(creds.username, WEBUI_AUTH_USERNAME)
        pass_ok = hmac.compare_digest(creds.password, WEBUI_AUTH_PASSWORD)
        return user_ok and pass_ok
    except Exception:
        return False


def _request_is_authenticated(req) -> bool:
    return _has_bearer_access(req) or _has_basic_access(req)


