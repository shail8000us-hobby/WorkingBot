def sync_legacy_params(updates):
    """
    Normalise update payloads to canonical ``GRIDBOT_*`` parameters.

    Legacy ``GRID_*`` style keys are migrated once (for backwards
    compatibility) and then removed from the payload so we never persist them
    back to disk.

    Auto-calculated:
    - MAX_OPEN_ORDERS = GRIDBOT_MAX_OPEN × 2 (each position needs BUY + TP)
    """
    synced_updates = dict(updates)
    migrated, _ = upgrade_mapping(synced_updates, record=False)
    for legacy in migrated:
        if REFACTOR_COMPAT_ENABLED:
            print(f"  [SYNC] {legacy} → {LEGACY_TO_CANONICAL[legacy]} = {synced_updates[LEGACY_TO_CANONICAL[legacy]]}")
        _record_legacy_usage(legacy)
    
    # Auto-calculate MAX_OPEN_ORDERS from GRIDBOT_MAX_OPEN
    # Each position needs 2 orders: BUY (entry) + TP (exit)
    if 'GRIDBOT_MAX_OPEN' in synced_updates:
        try:
            max_open = int(synced_updates['GRIDBOT_MAX_OPEN'])
            max_orders = max_open * 2
            synced_updates['MAX_OPEN_ORDERS'] = str(max_orders)
            if REFACTOR_COMPAT_ENABLED:
                print(f"  [CALC] MAX_OPEN_ORDERS = {max_open} positions × 2 = {max_orders} orders")
        except ValueError:
            pass
    
    # Legacy keys should never be persisted
    strip_legacy_keys(synced_updates)

    return synced_updates

