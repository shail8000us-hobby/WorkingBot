    flat = {key: details.get('value', "") for key, details in structured.items()}
    return _redact_flat_config(flat) if redact else flat


def _lookup_state_value(state_data: Dict[str, Any], canonical_key: str) -> Optional[Any]:
    candidates = [canonical_key]
    legacy_key = CANONICAL_TO_LEGACY.get(canonical_key)
    if legacy_key:
        candidates.append(legacy_key)

    nested_config = state_data.get('config') if isinstance(state_data.get('config'), dict) else {}
    for candidate in candidates:
        if candidate in state_data:
            return state_data[candidate]
        if candidate in nested_config:
            return nested_config[candidate]
    return None


def _coerce_numeric(value: Any) -> Optional[float]:
    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return None


def _values_equal(config_value: Any, state_value: Any) -> bool:
    config_num = _coerce_numeric(config_value)
    state_num = _coerce_numeric(state_value)
    if config_num is not None and state_num is not None:
        return abs(config_num - state_num) < 1e-9
    return str(config_value).strip() == str(state_value).strip()


def log_config_state_drift():
    """Log a prominent warning if config/state values are out of sync."""
    try:
        config_snapshot = get_structured_config(redact=False, normalize=True)
        config_values = {key: details.get('value') for key, details in config_snapshot.items()}

        if not STATE_FILE.exists():
            return

        state_data = load_state_file(STATE_FILE)

        drift_entries = []
        for key in DRIFT_MONITORED_KEYS:
            config_value = config_values.get(key)
            state_value = _lookup_state_value(state_data, key)
            if config_value is None or state_value is None:
                continue
            if not _values_equal(config_value, state_value):
                drift_entries.append((key, config_value, state_value))

        if drift_entries:
            print("\n" + "=" * 80)
            print("🚨  CONFIG / STATE DRIFT DETECTED 🚨")
            for key, config_val, state_val in drift_entries:
                legacy = CANONICAL_TO_LEGACY.get(key)
                state_key = legacy or key
                print(f"  {key}: grid_config={config_val} vs state[{state_key}]={state_val}")
            print("⚠️  Please reconcile grid_config.env and state*.json before trading.")
            print("=" * 80 + "\n")
    except Exception as exc:
        print(f"⚠️  Failed to evaluate config/state drift: {exc}")


def write_config_file(config_dict):
    """Write configuration back to grid_config.env"""
    global last_config_update
    
    # Read the original file to preserve structure and comments
    original_lines = []
    if CONFIG_FILE.exists():
        with open(CONFIG_FILE, 'r') as f:
            original_lines = f.readlines()

    # Update values in place
    updated_lines = []
    pending_updates = dict(config_dict)
    for line in original_lines:
        stripped = line.strip()
        if '=' in stripped and not stripped.startswith('#'):
            key = stripped.split('=', 1)[0].strip()
            if key in LEGACY_TO_CANONICAL:
                # Drop legacy keys from persisted config
                continue
            if key in pending_updates:
                # Update this line
                value = pending_updates.pop(key)
                # Preserve original formatting (quotes, spacing)
                if '"' in line or "'" in line:
                    updated_lines.append(f'{key}="{value}"\n')
                else:
                    updated_lines.append(f'{key}={value}\n')
            else:
                updated_lines.append(line)
        else:
            updated_lines.append(line)

    for key, value in pending_updates.items():
        updated_lines.append(f'{key}={value}\n')

    # Write back atomically
    _atomic_write_text(CONFIG_FILE, ''.join(updated_lines))
    
    last_config_update = time.time()
    
    # Notify all connected clients
    socketio.emit('config_updated', get_structured_config(redact=True, normalize=True))


