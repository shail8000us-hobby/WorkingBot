@app.route('/api/config/update', methods=['POST'])
def update_all_config():
    """Update multiple configuration values in grid_config.env"""
    try:
        updates = request.json
        
        if not updates:
            return jsonify({
                'success': False,
                'error': 'No configuration updates provided'
            }), 400
        
        print(f"[CONFIG UPDATE] Received {len(updates)} parameter(s)")
        
        # Auto-sync legacy and modern parameters
        synced_updates = sync_legacy_params(updates)
        
        if len(synced_updates) > len(updates):
            print(f"[SYNC] Auto-synced {len(synced_updates) - len(updates)} additional parameter(s)")
        
        # Read current file
        with open(CONFIG_FILE, 'r') as f:
            lines = f.readlines()
        
        # Update lines
        updated_lines = []
        updated_keys = set()
        
        for line in lines:
            stripped = line.strip()
            # Check if this line contains a key we want to update
            if stripped and not stripped.startswith('#') and '=' in stripped:
                key = stripped.split('=', 1)[0]
                if key in synced_updates:
                    # Preserve indentation
                    indent = len(line) - len(line.lstrip())
                    updated_lines.append(' ' * indent + f'{key}={synced_updates[key]}\n')
                    updated_keys.add(key)
                    continue
            updated_lines.append(line)
        
        # Write back atomically
        _atomic_write_text(CONFIG_FILE, ''.join(updated_lines))
        
        print(f"[CONFIG UPDATE] Successfully updated {len(updated_keys)} parameter(s) in grid_config.env")
        
        # Reload environment variables
        from dotenv import load_dotenv
        load_dotenv(CONFIG_FILE, override=True)
        
        return jsonify({
            'success': True,
            'message': f'Updated {len(updated_keys)} configuration values (auto-synced legacy params). Restart bot to apply changes.'
        })
    except Exception as e:
        print(f"[CONFIG UPDATE ERROR] {e}")
        import traceback
        traceback.print_exc()
        return jsonify({
            'success': False,
            'error': str(e)
        }), 500


