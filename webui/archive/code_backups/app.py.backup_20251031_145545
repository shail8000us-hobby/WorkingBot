@app.route('/api/trading_status', methods=['GET'])
def get_trading_status():
    """
    Get comprehensive trading status including blockers, bot state, and metrics.
    This is the main API for the Trading Status Panel.
    """
    try:
        from bot.safety.blocker_tracker import get_blocker_tracker
        
        # Get blocker status
        tracker = get_blocker_tracker()
        blocker_data = tracker.check_all_blockers()

        # ----------------------------------------------------------------------------
        # Sync with bot terminal: detect Two-Man Rule / startup hold from bot logs
        # If the bot is waiting for confirmation, surface it as a critical blocker so
        # the WebUI reflects the actual terminal state.
        # ----------------------------------------------------------------------------
        try:
            import os
            import re
            from pathlib import Path

            log_file = Path('/Users/shailendrasinghrajawat/Documents/WorkingBot/bot/logs/bot.log')
            startup_hold = False
            confirm_file_hint = None

            if log_file.exists():
                # Read last ~8KB to avoid heavy IO
                with log_file.open('rb') as f:
                    try:
                        f.seek(-8192, os.SEEK_END)
                    except OSError:
                        f.seek(0)
                    tail = f.read().decode(errors='ignore')

                if ('CONFIG CHANGE REQUIRES CONFIRMATION' in tail or
                    'Waiting for confirmation' in tail):
                    startup_hold = True
                    m = re.search(r"touch\s+\.(confirm_[a-f0-9]+)", tail)
                    if m:
                        confirm_file_hint = f".{m.group(1)}"

            if startup_hold:
                blocker_data['blockers'].append({
                    'id': 'two_man_rule_hold',
                    'category': 'STARTUP_HOLD',
                    'name': 'Two‑Man Rule Confirmation Required',
                    'severity': 'critical',
                    'active': True,
                    'message': 'Bot is waiting for configuration change confirmation',
                    'details': {
                        'confirm_file': confirm_file_hint,
                        'hint': 'Create the confirmation file to proceed'
                    },
                    'actions': ['confirm_changes'],
                    'deep_link': {
                        'tab': 'emergency_controls',
                        'section': 'emergency_status'
                    }
                })

                # When confirmation is pending, trading is effectively blocked
                blocker_data['trading_allowed'] = False
                blocker_data['total_blockers'] = blocker_data.get('total_blockers', 0) + 1
        except Exception as e:
            # Never break status endpoint due to log parsing
            print(f"Error in Two-Man Rule detection: {e}")
            pass
        
        # Get bot status
        bot_running = is_bot_running()
        
        # Get current positions and PnL
        positions_file = get_mode_specific_file('positions.json')
        positions = []
        total_pnl = 0
        
        # Only show positions if bot is running
        if bot_running and positions_file.exists():
            try:
                positions_data = load_positions_file(positions_file)
                positions = positions_data.get('positions', [])
                for pos in positions:
                    total_pnl += pos.get('unrealized_pnl', 0)
            except Exception:
                pass
        
        # Get pending orders count
        pending_orders = 0
        state_file = get_mode_specific_file('state.json')
        if state_file.exists():
            try:
                state = load_state_file(state_file)
                pending_orders = len(state.get('pending_orders', []))
            except Exception:
                pass
        
        # Get bot start time
        bot_start_time = None
        bot_pid_file = get_bot_pid_path()
        if bot_pid_file.exists():
            try:
                bot_start_time = datetime.fromtimestamp(bot_pid_file.stat().st_mtime).isoformat()
            except Exception:
                pass
        
        # Determine trading status
        if not bot_running:
            trading_status = 'bot_stopped'
        elif not blocker_data['trading_allowed']:
            trading_status = 'blocked'
        else:
            trading_status = 'active'
        
        return jsonify({
            'success': True,
            'status': {
                'trading_status': trading_status,
                'bot_running': bot_running,
                'bot_start_time': bot_start_time,
                'trading_allowed': blocker_data['trading_allowed'],
                'total_blockers': blocker_data['total_blockers']
            },
            'metrics': {
                'open_positions': len(positions),
                'pending_orders': pending_orders,
                'total_pnl': total_pnl
            },
            'blockers': blocker_data['blockers'],
            'timestamp': blocker_data['timestamp']
        })
    except Exception as e:
        return jsonify({
            'success': False,
            'error': str(e)
        }), 500


