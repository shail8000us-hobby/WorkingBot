class HotFileCache:
    """Simple timed cache for frequently-read JSON files."""

    def __init__(self, path: Path, ttl_seconds: float):
        self.path = Path(path)
        self.ttl = max(ttl_seconds, 0.05)
        self._lock = Lock()
        self._data: Optional[Any] = None
        self._timestamp = 0.0
        self._mtime = 0.0

    def get(self, loader):
        now = time.time()
        with self._lock:
            if self._data is not None and (now - self._timestamp) < self.ttl:
                try:
                    current_mtime = self.path.stat().st_mtime
                except FileNotFoundError:
                    current_mtime = 0.0
                if current_mtime == self._mtime:
                    return self._data

        data = loader()

        with self._lock:
            self._data = data
            self._timestamp = now
            try:
                self._mtime = self.path.stat().st_mtime
            except FileNotFoundError:
                self._mtime = 0.0
            return self._data

    def invalidate(self) -> None:
        with self._lock:
            self._data = None
            self._timestamp = 0.0
            self._mtime = 0.0


