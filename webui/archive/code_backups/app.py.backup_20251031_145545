def _normalize_exchange_order(order: Dict[str, Any], mode: str, triggered_by: str) -> Optional[Dict[str, Any]]:
    """Convert a raw exchange order into the audit memory schema."""
    if not isinstance(order, dict):
        return None

    now_iso = datetime.utcnow().isoformat()
    created_at = order.get("created_at") or now_iso
    updated_at = order.get("updated_at") or created_at

    try:
        qty = order.get("size") or order.get("quantity")
        price = order.get("limit_price") or order.get("price")
        filled = order.get("filled_size")
        avg_fill = order.get("average_fill_price")

        record: Dict[str, Any] = {
            "ts": now_iso,
            "timestamp": created_at,
            "updated_at": updated_at,
            "mode": mode,
            "source": "exchange_rebuild",
            "triggered_by": triggered_by,
            "order_id": str(order.get("id") or ""),
            "client_order_id": order.get("client_order_id"),
            "symbol": order.get("product_symbol") or order.get("symbol"),
            "side": order.get("side"),
            "qty": float(qty) if qty is not None else None,
            "price": float(price) if price is not None else None,
            "state": order.get("state"),
            "status": order.get("state"),
            "exchange_status": order.get("state"),
            "filled_size": float(filled) if filled is not None else None,
            "avg_fill_price": float(avg_fill) if avg_fill is not None else None,
            "category": "rebuild",
            "rebuild": True,
            "fees": order.get("commission"),
            "reduce_only": order.get("reduce_only"),
        }

        for extra_key in ("product_id", "product_symbol", "time_in_force", "type"):
            if extra_key in order and extra_key not in record:
                record[extra_key] = order[extra_key]

        return record
    except Exception as exc:
        print(f"⚠️  Failed to normalize exchange order {order}: {exc}")
        return None


@app.route('/api/recon/clear-orders-memory', methods=['POST'])
def clear_orders_memory():
    """
    Clear the bot's order memory JSON file with optional rebuild from the exchange.
    """
    # Use new bulletproof reconciliation system
    from bot.reconciliation import get_reconciliation_engine
    engine = get_reconciliation_engine()

    payload = request.get_json(silent=True) or {}
    confirmation = str(
        payload.get('confirmation') or
        payload.get('confirm_text') or
        ''
    ).strip().upper()

    if confirmation != "CLEAR_ORDERS":
        return jsonify({
            "status": "error",
            "error": "Confirmation phrase mismatch. Type CLEAR_ORDERS to confirm."
        }), 400

    rebuild_requested = bool(payload.get('rebuild') or payload.get('rebuild_from_exchange'))
    triggered_by = payload.get('triggered_by') or 'manual'
    initiator_ip = request.remote_addr

    orders_before = 0
    backup_path = None
    rebuild_records: List[Dict[str, Any]] = []
    summary: Dict[str, Any] = {}
    error_message = None
    resume_error = None

    original_execute = get_config_value('EXECUTE_ORDERS', 'false')
    trading_was_active = _as_bool(original_execute)
    trading_resumed = False

    with orders_memory_lock:
        snapshot_before = _build_orders_memory_snapshot()
        orders_before = snapshot_before.get("order_count", 0)
        mode = snapshot_before.get("mode") or _get_current_mode_safe()

        try:
            if trading_was_active:
                update_config_value('EXECUTE_ORDERS', 'False')

            backup_path = _backup_orders_memory_file()
            _write_orders_memory([])

            if rebuild_requested:
                # Note: fetch_open_orders_fresh not available in new system
                exchange_orders = []
                for order in exchange_orders:
                    normalized = _normalize_exchange_order(order, mode, triggered_by)
                    if normalized:
                        rebuild_records.append(normalized)
                _write_orders_memory(rebuild_records)

            last_cleared_at = datetime.utcnow().isoformat()

            sync_ok = False
            try:
                summary = engine.reconcile(force_refresh=True) or {}
                sync_ok = isinstance(summary, dict) and summary.get("status") == "success"
            except Exception as recon_exc:
                summary = {
                    "status": "error",
                    "error": str(recon_exc)
                }
                print(f"⚠️  Reconciliation refresh failed after clearing orders: {recon_exc}")

            status_record = {
                "last_cleared_at": last_cleared_at,
                "backup_path": str(backup_path) if backup_path else None,
                "triggered_by": triggered_by,
                "initiator_ip": initiator_ip,
                "orders_before": orders_before,
                "orders_after": len(rebuild_records) if rebuild_requested else 0,
                "rebuild_requested": rebuild_requested,
                "orders_imported": len(rebuild_records),
                "sync_ok": sync_ok,
                "sync_error": summary.get("error") if isinstance(summary, dict) else None,
                "mode": mode,
            }
            _write_orders_memory_status(status_record)

        except Exception as exc:
            error_message = str(exc)
        finally:
            if trading_was_active:
                try:
                    update_config_value('EXECUTE_ORDERS', original_execute or 'true')
                    trading_resumed = True
                except Exception as resume_exc:
                    resume_error = str(resume_exc)

    if error_message:
        response = {
            "status": "error",
            "error": error_message,
            "orders_before": orders_before,
            "rebuild_requested": rebuild_requested,
            "backup_path": str(backup_path) if backup_path else None,
            "trading_was_active": trading_was_active,
            "trading_resumed": trading_resumed,
        }
        if resume_error:
            response["resume_error"] = resume_error
        return jsonify(response), 500

    snapshot_after = _build_orders_memory_snapshot()
    snapshot_after["orders_before"] = orders_before
    snapshot_after["rebuild_requested"] = rebuild_requested
    snapshot_after["rebuild_imported"] = len(rebuild_records)
