        accepts_gzip = 'gzip' in request.headers.get('Accept-Encoding', '')
        gz_path = path + '.gz'
        gz_file = os.path.join(app.static_folder, gz_path)
        
        # Serve pre-compressed .gz file if available (from webpack CompressionPlugin)
        if accepts_gzip and os.path.exists(gz_file) and path.endswith(('.js', '.css', '.html')):
            try:
                with open(gz_file, 'rb') as f:
                    compressed_content = f.read()
                
                response = Response(compressed_content)
                if path.endswith('.js'):
                    response.headers['Content-Type'] = 'application/javascript'
                elif path.endswith('.css'):
                    response.headers['Content-Type'] = 'text/css'
                elif path.endswith('.html'):
                    response.headers['Content-Type'] = 'text/html'
                
                response.headers['Content-Encoding'] = 'gzip'
                response.headers['Content-Length'] = str(len(compressed_content))
                response.headers['Vary'] = 'Accept-Encoding'
                
                # Cache headers: force refresh for AI Advisor fix
                response.headers['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
                
                return response
            except Exception as e:
                print(f"⚠️  Pre-gzipped file serving failed for {path}: {e}")
                # Fall back to normal serving
        
        # Normal file serving (Flask-Compress will handle compression)
        response = send_from_directory(app.static_folder, path)
    else:
        response = send_from_directory(app.static_folder, 'index.html')
    
    # Cache headers: force refresh for AI Advisor fix
    if '/static/' in path and '.' in os.path.basename(path).split('.')[-2]:
        # Versioned static file - short cache to force refresh
        response.headers['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
    elif path.endswith('.html') or path == '':
        # HTML files - no cache to allow updates
        response.headers['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
    else:
        # Other files - no cache to force refresh
        response.headers['Cache-Control'] = 'no-store, no-cache, must-revalidate, max-age=0'
    
    return response


