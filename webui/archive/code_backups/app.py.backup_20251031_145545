                        reader = csv.DictReader(f)
                        rows = list(reader)
                    
                    current_row_count = len(rows)
                    
                    # If new data added, emit update
                    if current_row_count > last_row_count:
                        # Get last 120 entries for chart
                        history = []
                        for row in rows[-120:]:
