def _load_orders_memory_entries() -> List[Dict[str, Any]]:
    """Read bot order memory entries, handling empty sentinel lines."""
    entries: List[Dict[str, Any]] = []
    if not ORDERS_MEMORY_FILE.exists():
        return entries
    try:
        with ORDERS_MEMORY_FILE.open('r', encoding='utf-8', errors='replace') as audit:
            for raw_line in audit:
                line = raw_line.strip()
                if not line:
                    continue
                try:
                    payload = json.loads(line)
                except Exception:
                    continue
                if isinstance(payload, list):
                    for item in payload:
                        if isinstance(item, dict):
                            entries.append(item)
                    continue
                if isinstance(payload, dict):
                    entries.append(payload)
    except Exception as exc:
        print(f"⚠️  Failed to read orders memory: {exc}")
    return entries


def _write_orders_memory(records: List[Dict[str, Any]]) -> None:
    """Persist order memory entries atomically."""
    ORDERS_MEMORY_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp_file = None
    try:
        with tempfile.NamedTemporaryFile(
            mode='w',
            encoding='utf-8',
            dir=str(ORDERS_MEMORY_FILE.parent),
            delete=False
        ) as tmp:
            tmp_file = tmp.name
            if not records:
                tmp.write("[]\n")
            else:
                for record in records:
                    tmp.write(json.dumps(record, ensure_ascii=False) + "\n")
        os.replace(tmp_file, ORDERS_MEMORY_FILE)
    except Exception as exc:
        if tmp_file and os.path.exists(tmp_file):
            os.unlink(tmp_file)
        raise RuntimeError(f"Failed to write orders memory: {exc}") from exc


def _backup_orders_memory_file() -> Optional[Path]:
    """Create a timestamped backup of the orders memory file."""
    if not ORDERS_MEMORY_FILE.exists():
