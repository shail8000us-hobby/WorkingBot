class ProcessAlreadyRunning(Exception):
    """Raised when attempting to start a process that already holds the PID lock."""


def get_bot_pid_path() -> Path:
    return BASE_DIR / 'reports' / 'bot.pid'


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _read_pid(fp) -> Optional[int]:
    fp.seek(0)
    content = fp.read().strip()
    if not content:
        return None
    try:
        return int(content)
    except ValueError:
        return None


def _acquire_bot_pid_lock() -> Any:
    path = get_bot_pid_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    fp = open(path, 'a+')
    try:
        fcntl.flock(fp.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        existing_pid = _read_pid(fp)
        fp.close()
        raise ProcessAlreadyRunning(existing_pid or 0)

    existing_pid = _read_pid(fp)
    if existing_pid and _pid_alive(existing_pid):
        fcntl.flock(fp.fileno(), fcntl.LOCK_UN)
        fp.close()
        raise ProcessAlreadyRunning(existing_pid)

    fp.seek(0)
    fp.truncate()
    return fp


def _release_bot_pid_lock(remove_file: bool = False) -> None:
    global bot_pid_file_handle
    path = get_bot_pid_path()
    if bot_pid_file_handle:
        try:
            fcntl.flock(bot_pid_file_handle.fileno(), fcntl.LOCK_UN)
        except Exception:
            pass
        try:
            bot_pid_file_handle.close()
        except Exception:
            pass
        bot_pid_file_handle = None
    if remove_file and path.exists():
        try:
            path.unlink()
        except Exception:
            pass


def get_bot_pid():
    """Find running bot process"""
    global bot_process
    if bot_process and hasattr(bot_process, 'poll') and bot_process.poll() is None:
        return bot_process.pid

    path = get_bot_pid_path()
    if path.exists():
        try:
            pid = int(path.read_text().strip() or '0')
        except ValueError:
            pid = 0
        if pid and _pid_alive(pid):
            return pid
        if pid and not _pid_alive(pid):
            _release_bot_pid_lock(remove_file=True)
    return None


