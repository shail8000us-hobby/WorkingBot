        rv_for_calc = rv if rv else 0
        iv_for_calc = iv if iv else 0
        
        # Calculate Volatility Signal
        if iv and rv:
            if iv > rv * 1.1:
                vol_signal = "IV_HIGH"
                vol_color = "red"
            elif iv < rv * 0.9:
                vol_signal = "IV_LOW"
                vol_color = "yellow"
            else:
                vol_signal = "NEUTRAL"
                vol_color = "green"
        else:
