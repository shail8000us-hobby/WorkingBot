def _rotate_log_file(log_path: Path, max_bytes: int, backups: int) -> None:
    if not log_path.exists() or log_path.stat().st_size < max_bytes:
        return
    for index in range(backups, 0, -1):
        rotated = Path(f"{log_path}.{index}")
        if rotated.exists():
            rotated.unlink()
        source = Path(f"{log_path}.{index - 1}") if index > 1 else log_path
        if source.exists():
            source.rename(rotated)


def _open_process_log(log_path: Path) -> Any:
    WEBUI_LOG_DIR.mkdir(parents=True, exist_ok=True)
    _rotate_log_file(log_path, PROCESS_LOG_MAX_BYTES, PROCESS_LOG_BACKUPS)
    return open(log_path, 'ab', buffering=0)


