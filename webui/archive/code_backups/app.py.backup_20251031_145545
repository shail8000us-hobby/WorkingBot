@app.route('/api/config', methods=['POST'])
def update_config():
    """
    Save Configuration Changes
    
    Saves configuration changes to grid_config.env file. Changes take effect
    immediately if Hot Reload is enabled, otherwise require bot restart.
    
    Effects:
    - Writes updated parameters to grid_config.env
    - Auto-syncs legacy and modern parameter names
    - Triggers Hot Reload if enabled (bot automatically picks up changes)
    - Updates all related parameters (e.g., updating GRIDBOT_LOWER also syncs GRID_LOWER_PRICE)
    - Notifies connected clients via WebSocket
    
    Risks:
    - Invalid grid parameters may cause bot errors
    - Changing grid geometry while bot is running may cancel existing orders
    - Always verify parameters before saving
    - Keep backup of working configuration
    
    Related Config:
    All GRIDBOT_*, GRID_*, GUARDIAN_*, and trading parameters can be updated.
    HOT_RELOAD_ENABLED determines if changes apply without restart.
    """
    try:
        updates = request.json
        print(f"Received config update: {len(updates) if updates else 0} parameters")
        if not updates:
            raise ValueError("No configuration data received")
        
        # Auto-sync legacy and modern parameters
        synced_updates = sync_legacy_params(updates)
        
        if len(synced_updates) > len(updates):
            print(f"[SYNC] Auto-synced {len(synced_updates) - len(updates)} additional parameter(s)")
        
        write_config_file(synced_updates)
        return jsonify({'success': True, 'message': f'Configuration updated ({len(synced_updates)} params, auto-synced)'})
    except Exception as e:
        print(f"Config update error: {type(e).__name__}: {str(e)}")
        import traceback
        traceback.print_exc()
        return jsonify({'success': False, 'message': str(e)}), 400


