@app.route('/api/robustness/volatility/update-config', methods=['POST'])
def update_volatility_config():
    """Update volatility configuration in grid_config.env"""
    try:
        import re
        data = request.get_json()
        
        # Map frontend keys to config keys
        config_mapping = {
            'max_iv': 'VOLATILITY_MAX_IV',
            'max_rv': 'VOLATILITY_MAX_RV',
            'max_spread': 'VOLATILITY_MAX_SPREAD',
            'check_interval': 'VOLATILITY_CHECK_INTERVAL'
        }
        
        # Read current config
        with open(CONFIG_FILE, 'r') as f:
            config_content = f.read()
        
        # Update each value
        updated_count = 0
        for key, value in data.items():
            if key in config_mapping:
                config_key = config_mapping[key]
                # Find and replace the line
                pattern = rf'^({config_key}\s*=\s*)(.+?)(\s*#.*)?$'
                replacement = rf'\g<1>{value}\3'
                new_content, count = re.subn(pattern, replacement, config_content, flags=re.MULTILINE)
                if count > 0:
                    config_content = new_content
                    updated_count += count
        
        if updated_count == 0:
            return jsonify({
                'success': False,
                'error': 'No matching configuration keys found'
            }), 400
        
        # Write updated config atomically
        _atomic_write_text(CONFIG_FILE, config_content)
        
        return jsonify({
            'success': True,
            'message': f'Updated {updated_count} volatility setting(s). Restart bot to apply changes.'
        })
    except Exception as e:
        return jsonify({
            'success': False,
            'error': str(e)
        }), 500


