@app.route('/api/emergency/force_restart', methods=['POST'])
def force_restart():
    """
    Force Restart Bot
    
    Forcefully restarts the trading bot by killing existing process and starting a new one.
    This is a more aggressive action than normal stop/start - use when bot is unresponsive.
    
    Effects:
    - Kills existing bot process (SIGTERM first, SIGKILL if needed)
    - Waits for process to terminate
    - Starts new bot process
    - Existing orders remain on exchange (NOT cancelled)
    - Positions preserved
    - Bot state reloaded from files
    
    Risks:
    - Orders in flight may not be tracked immediately
    - Brief trading interruption (1-2 seconds)
    - Unresponsive bot may not stop cleanly
    - State sync issues if bot was mid-operation
    
    Use Cases:
    - Bot is frozen/unresponsive
    - After critical configuration change
    - When normal stop/start doesn't work
    - Emergency recovery situation
    
    Post-Action:
    - Verify bot started successfully
    - Check logs for startup errors
    - Reconcile positions and orders
    - Monitor for normal operation
    
    Related Config:
    BOT_SCRIPT_PATH, PYTHON_EXECUTABLE, TRADING_MODE
    """
    """Force restart bot - self-service"""
    try:
        import subprocess
        import signal
        import os
        
        # Get current bot PID
        bot_pid = None
        try:
            with open('bot.pid', 'r') as f:
                bot_pid = int(f.read().strip())
        except:
            pass
        
        # Kill existing bot process
        if bot_pid:
            try:
                os.kill(bot_pid, signal.SIGTERM)
                time.sleep(2)
                # Force kill if still running
                try:
                    os.kill(bot_pid, signal.SIGKILL)
                except:
                    pass
            except:
                pass
        
        # Start new bot process using UNIFIED LAUNCHER
        subprocess.run([
            'python3', 'bot_launcher.py', '--daemon'
        ], cwd=os.getcwd())
        
        return jsonify({
            'success': True,
            'message': 'Bot restart initiated successfully',
            'action': 'force_restart'
        })
        
    except Exception as e:
        return jsonify({
            'success': False,
            'error': str(e),
            'message': 'Failed to restart bot'
        }), 500


