@app.route('/api/help/registry', methods=['GET'])
def get_help_registry():
    """
    @help:action_id=help.registry
    @help:title=Get Help Registry
    @help:summary=Retrieves the complete help metadata registry for all UI actions
    @help:impact=Returns help information for all actions, filters out secrets
    
    Get the help registry with all action metadata.
    No authentication required. Secrets are automatically filtered.
    """
    try:
        if not HELP_REGISTRY_FILE.exists():
            return jsonify({
                'success': False,
                'message': 'Help registry not found. Run: python3 tools/help/extract_help_metadata.py',
                'actions': []
            }), 404
        
        with open(HELP_REGISTRY_FILE, 'r') as f:
            registry = json.load(f)
        
        # Filter out any secrets from related_config
        for action in registry:
            if 'related_config' in action:
                # Handle both formats: list of dicts (auto-generated) and list of strings (synthetic)
                filtered_config = []
                for config in action['related_config']:
                    if isinstance(config, dict):
                        # Auto-generated format: {"key": "CONFIG_KEY", "value": "val", "source": "file"}
                        if config.get('key') and not any(
                            secret in config['key'].upper()
                            for secret in ['KEY', 'SECRET', 'PASSWORD', 'TOKEN', 'CREDENTIALS']
                        ):
                            filtered_config.append(config)
                    elif isinstance(config, str):
                        # Synthetic format: just the key name as a string
                        if not any(secret in config.upper() for secret in ['KEY', 'SECRET', 'PASSWORD', 'TOKEN', 'CREDENTIALS']):
                            filtered_config.append(config)
                action['related_config'] = filtered_config
        
        return jsonify({
            'success': True,
            'actions': registry,
            'count': len(registry),
            'generated_at': HELP_REGISTRY_FILE.stat().st_mtime if HELP_REGISTRY_FILE.exists() else None
        })
    except Exception as e:
        print(f"[API ERROR] Help registry fetch failed: {e}")
        return jsonify({
            'success': False,
            'error': str(e),
            'actions': []
        }), 500


