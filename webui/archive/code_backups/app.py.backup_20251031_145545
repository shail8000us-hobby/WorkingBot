@app.route('/api/docs/<path:filename>')
def serve_docs(filename):
    """Serve markdown documentation files"""
    try:
        # Security: only allow .md files
        if not filename.endswith('.md'):
            return {'error': 'Only markdown files allowed'}, 403
        
        # Get the project root directory (3 levels up from this file)
        project_root = Path(__file__).parent.parent.parent
        doc_path = project_root / filename
        
        # Security: ensure the file is within project root
        if not str(doc_path.resolve()).startswith(str(project_root.resolve())):
            return {'error': 'Access denied'}, 403
        
        # Check if file exists
        if not doc_path.exists():
            return {'error': f'Documentation file not found: {filename}'}, 404
        
        # Read and return the file content
        with open(doc_path, 'r', encoding='utf-8') as f:
            content = f.read()
        
        # Return as plain text with proper content type
        from flask import Response
        return Response(content, mimetype='text/markdown')
    
    except Exception as e:
        print(f"Error serving documentation: {e}")
        return {'error': str(e)}, 500



