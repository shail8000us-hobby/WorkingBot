@app.route('/api/pnl-history/hourly', methods=['GET'])
def get_hourly_pnl_history():
    """Get hourly PnL history - samples from CSV at hourly intervals"""
    import csv
    
    # Get today's CSV file
    today = datetime.now().strftime("%Y%m%d")
    csv_file = Path('bot/reports') / f"pnl_history_{today}.csv"
    
    history = []
    hourly_data = {}
    
    if not csv_file.exists():
        return jsonify({'history': []})
    
    with open(csv_file, 'r') as f:
        reader = csv.DictReader(f)
        for row in reader:
            try:
                # Parse timestamp
                timestamp_str = row.get('timestamp', '')
                if not timestamp_str:
                    continue
                    
                dt = datetime.fromisoformat(timestamp_str)
                
                # Get hour key (e.g., "00", "01", "13")
                hour_key = dt.strftime('%H')
                
                # Store the latest entry for each hour
                pnl_value = float(row.get('total_pnl', 0))
                
                hourly_data[hour_key] = {
                    'timestamp': timestamp_str,
                    'time': f"{hour_key}:00",
                    'pnl': pnl_value,
                    'total_pnl': pnl_value
                }
            except Exception:
                continue
    
    # Convert to sorted list
    for hour in sorted(hourly_data.keys()):
        history.append(hourly_data[hour])
    
    return jsonify({'history': history})



