SECRET_KEY_PATTERN = re.compile(r"(KEY|SECRET|PASSWORD|TOKEN)", re.IGNORECASE)
REDACTED_PLACEHOLDER = "***"

LEGACY_TO_CANONICAL: Dict[str, str] = dict(ALIAS_TO_CANONICAL)
