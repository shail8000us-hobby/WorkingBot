@app.route('/api/recon/clear-bot-memory', methods=['POST'])
def clear_bot_memory():
    """
    Clear bot's order memory (orders.jsonl) - SMART MODE
    
    - Keeps OPEN orders (don't break active trades)
    - Removes CLOSED/FILLED/CANCELLED orders (cleans old data)
    - Creates backup before clearing
    - Does NOT affect volatility recovery (.volatility_halt.json is separate)
    """
    try:
        import shutil
        from pathlib import Path
        
        # Get the orders.jsonl file path
        orders_file = BASE_DIR / "bot" / "audit" / "orders.jsonl"
        
        if not orders_file.exists():
            return jsonify({
                'success': True,
                'message': 'No bot memory to clear (orders.jsonl does not exist)',
                'cleared_orders': 0,
                'kept_orders': 0
            })
        
        # Read all orders
        all_orders = []
        open_orders = []
        closed_orders = []
        
        with open(orders_file, 'r') as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith('#'):
                    continue
                try:
                    order = json.loads(line)
                    all_orders.append(order)
                    
                    # Keep OPEN orders (active trades)
                    if order.get('status', '').lower() in ['open', 'pending']:
                        open_orders.append(order)
                    else:
                        closed_orders.append(order)
                except json.JSONDecodeError:
                    continue
        
        total_count = len(all_orders)
        kept_count = len(open_orders)
        cleared_count = len(closed_orders)
        
        # Create backup before clearing
        backup_dir = BASE_DIR / "backups" / "order_memory"
        backup_dir.mkdir(parents=True, exist_ok=True)
        backup_file = backup_dir / f"orders_backup_{datetime.now().strftime('%Y%m%d_%H%M%S')}.jsonl"
        shutil.copy2(orders_file, backup_file)
        
        # Rewrite file with only OPEN orders
        with open(orders_file, 'w') as f:
            f.write("# Bot Order Audit Trail - JSONL Format\n")
            for order in open_orders:
                f.write(json.dumps(order) + '\n')
        
        print(f"✅ Smart Clear Bot Memory:")
        print(f"   Total orders: {total_count}")
        print(f"   Kept (open): {kept_count}")
        print(f"   Cleared (closed): {cleared_count}")
        print(f"   Backup: {backup_file}")
        
        return jsonify({
            'success': True,
            'message': f'Cleared {cleared_count} closed orders, kept {kept_count} open orders',
            'total_orders': total_count,
            'cleared_orders': cleared_count,
            'kept_orders': kept_count,
            'backup_path': str(backup_file.relative_to(BASE_DIR))
        })
    except Exception as e:
        import traceback
        print(f"❌ Error clearing bot memory: {e}")
        print(traceback.format_exc())
        return jsonify({
            'success': False,
            'error': str(e)
        }), 500


