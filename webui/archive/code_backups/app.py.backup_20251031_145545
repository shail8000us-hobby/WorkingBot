def tail_logs():
    """Stream logs in real-time"""
    if not LOG_FILE.exists():
        return
    
    try:
        with open(LOG_FILE, 'r') as f:
            # Go to end of file
            f.seek(0, 2)
            
            while True:
                line = f.readline()
                if line:
                    socketio.emit('log_entry', {'message': line.strip()})
                else:
                    time.sleep(0.5)
    except Exception as e:
        print(f"Error tailing logs: {e}")


def stream_positions():
    """Stream position updates to clients"""
    last_mtime = 0
    while True:
        try:
            positions_file = get_mode_specific_file("positions.json")
            if positions_file.exists():
                mtime = positions_file.stat().st_mtime
                if mtime > last_mtime:
                    data = load_positions_file(positions_file)
                    socketio.emit('positions_update', data)
                    last_mtime = mtime
        except Exception as e:
            print(f"Position stream error: {e}")
        time.sleep(5)  # Check every 5 seconds


def stream_bot_status():
    """Stream bot status updates to clients in real-time"""
    last_status = None
    while True:
        try:
            current_status = get_bot_status()
            
            # Only emit if status actually changed
            if current_status != last_status:
                socketio.emit('bot_status', current_status)
                last_status = current_status
        except Exception as e:
            print(f"Bot status stream error: {e}")
        time.sleep(2)  # Check every 2 seconds (faster for responsiveness)


