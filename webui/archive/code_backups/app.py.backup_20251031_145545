def _split_origin_list(raw_value: str) -> List[str]:
    """Split comma-separated origin string into a sanitized list."""
    return [item.strip() for item in raw_value.split(',') if item and item.strip()]


def _compile_allowed_origins(raw_value: str) -> Tuple[List[str], List[Union[str, Pattern]], List[Pattern]]:
    """
    Parse WEBUI_ALLOWED_ORIGINS into display strings, Flask CORS entries, and regex patterns.
    Supports entries like http://example.com, http://localhost:*, and wildcards with *.
    """
    entries = _split_origin_list(raw_value) or [DEFAULT_ALLOWED_ORIGINS]
    cors_entries: List[Union[str, Pattern]] = []
    patterns: List[Pattern] = []

    for entry in entries:
        if entry.endswith(':*'):
            base = entry[:-2]
            regex = re.compile(rf'^{re.escape(base)}(?::\d+)?$', re.IGNORECASE)
            cors_entries.append(regex)
            patterns.append(regex)
        elif '*' in entry:
            wildcard_regex = '^' + re.escape(entry).replace('\\*', '.*') + '$'
            regex = re.compile(wildcard_regex, re.IGNORECASE)
            cors_entries.append(regex)
            patterns.append(regex)
        else:
            cors_entries.append(entry)
            patterns.append(re.compile(rf'^{re.escape(entry)}$', re.IGNORECASE))

    return entries, cors_entries, patterns


def _origin_is_allowed(origin: Optional[str], patterns: List[Pattern]) -> bool:
    """Return True if the provided origin matches any allowed pattern."""
    if origin is None:
        # Same-origin or non-browser clients may omit Origin; treat as allowed.
        return True
    candidate = origin.strip().rstrip('/')
    for pattern in patterns:
        if pattern.match(candidate):
            return True
    return False

