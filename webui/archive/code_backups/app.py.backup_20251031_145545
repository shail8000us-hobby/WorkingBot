@app.route('/api/bots/status', methods=['GET'])
def get_all_bots_status():
    """
    Get status of all running bot processes.
    
    Returns detailed information about all Python bot processes:
    - Main trading bot (bot.run or bot/run.py)
    - Guardian bot (guardian_bot.py)
    - Heartbeat monitor (heartbeat_monitor.py)
    - WebUI backend (this process)
    
    Each bot includes: PID, name, type, command, uptime, CPU%, memory usage
    """
    try:
        if psutil is None:
            return jsonify({
                'success': False,
                'error': 'psutil module not installed. Run: pip install psutil',
                'bots': [],
                'totalBots': 0
            }), 500
        
        bots = []
        current_pid = os.getpid()  # WebUI backend process
        
        # Iterate through all running processes
        for proc in psutil.process_iter(['pid', 'name', 'cmdline', 'create_time', 'cpu_percent', 'memory_info']):
            try:
                cmdline = proc.info.get('cmdline') or []
                cmdline_str = ' '.join(cmdline).lower()
                
                # Skip if not a Python process
                if 'python' not in cmdline_str:
                    continue
                
                # Detect bot type based on command
                bot_type = None
                bot_name = None
                
                if 'bot/run.py' in cmdline_str or 'bot.run' in cmdline_str:
                    if '--dry-run' in cmdline_str or 'dry_run' in cmdline_str:
                        bot_type = 'dry_run'
                        bot_name = 'Trading Bot (Dry Run)'
                    else:
                        bot_type = 'live_trading'
                        bot_name = 'Main Trading Bot'
                elif 'guardian_bot' in cmdline_str:
                    bot_type = 'guardian'
                    bot_name = 'Guardian Bot'
                elif 'heartbeat_monitor' in cmdline_str:
                    bot_type = 'monitor'
                    bot_name = 'Heartbeat Monitor'
                elif 'webui/backend/app.py' in cmdline_str or proc.info['pid'] == current_pid:
                    bot_type = 'webui'
                    bot_name = 'WebUI Backend'
                else:
                    # Skip other Python processes
                    continue
                
                # Calculate uptime
                create_time = proc.info.get('create_time', time.time())
                uptime_seconds = int(time.time() - create_time)
                hours = uptime_seconds // 3600
                minutes = (uptime_seconds % 3600) // 60
                
                if hours > 0:
                    uptime = f"{hours}h {minutes}m"
                else:
                    uptime = f"{minutes}m"
                
                # Get memory usage in MB
                memory_info = proc.info.get('memory_info')
                memory_mb = round(memory_info.rss / 1024 / 1024, 1) if memory_info else 0
                
                # Get CPU percentage (this requires a brief interval)
                cpu_percent = proc.cpu_percent(interval=0.1) or 0
                
                bots.append({
                    'pid': proc.info['pid'],
                    'name': bot_name,
                    'command': ' '.join(cmdline),
                    'type': bot_type,
                    'startedAt': datetime.fromtimestamp(create_time).isoformat(),
                    'uptime': uptime,
                    'status': 'running',
                    'cpuPercent': round(cpu_percent, 1),
                    'memoryMb': memory_mb
                })
                
            except (psutil.NoSuchProcess, psutil.AccessDenied, psutil.ZombieProcess):
                # Process disappeared or access denied, skip it
                continue
        
        return jsonify({
            'success': True,
            'bots': bots,
            'totalBots': len(bots)
        })
        
    except Exception as e:
        print(f"Error getting bot status: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({
            'success': False,
            'error': str(e),
            'bots': [],
            'totalBots': 0
        }), 500


@app.route('/api/bots/stop', methods=['POST'])
def stop_bot_by_pid():
    """
    Stop a specific bot process by PID.
    
    Safety features:
    - Prevents stopping the WebUI backend itself
    - Logs all stop actions
    - Uses SIGTERM first, then SIGKILL if needed
    
    Request body: { "pid": 12345 }
    """
    try:
        data = request.json
        pid = data.get('pid')
        
        if not pid:
            return jsonify({
                'success': False,
                'message': 'PID is required'
            }), 400
        
        # Convert to int
        try:
            pid = int(pid)
        except (ValueError, TypeError):
            return jsonify({
                'success': False,
                'message': 'Invalid PID format'
            }), 400
        
        # Safety check: Don't allow killing the WebUI backend itself
        current_pid = os.getpid()
        if pid == current_pid:
            return jsonify({
                'success': False,
                'message': 'Cannot stop WebUI backend from itself. Use system commands to restart the backend.'
            }), 403
        
        # Verify process exists and get its info
        if psutil is None:
            return jsonify({
                'success': False,
                'message': 'psutil module not installed'
            }), 500
        
        try:
            proc = psutil.Process(pid)
            cmdline = ' '.join(proc.cmdline())
            
            # Verify it's actually a bot process
            if 'python' not in cmdline.lower():
                return jsonify({
                    'success': False,
                    'message': f'PID {pid} is not a Python process'
                }), 400
            
            # Log the stop action
            print(f"[BOT MANAGER] Stopping process PID {pid}: {cmdline}")
            
            # Try graceful termination first (SIGTERM)
            proc.terminate()
            
            # Wait up to 5 seconds for graceful shutdown
            try:
                proc.wait(timeout=5)
                print(f"[BOT MANAGER] Process {pid} stopped gracefully")
            except psutil.TimeoutExpired:
                # Force kill if it didn't stop gracefully
                print(f"[BOT MANAGER] Process {pid} didn't stop gracefully, force killing...")
                proc.kill()
                print(f"[BOT MANAGER] Process {pid} force killed")
            
            return jsonify({
                'success': True,
                'message': f'Bot with PID {pid} stopped successfully'
            })
            
        except psutil.NoSuchProcess:
            return jsonify({
                'success': False,
                'message': f'No process found with PID {pid}'
            }), 404
        except psutil.AccessDenied:
            return jsonify({
                'success': False,
                'message': f'Access denied to stop process {pid}. May require elevated permissions.'
            }), 403
            
    except Exception as e:
        print(f"Error stopping bot: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({
            'success': False,
            'message': f'Error stopping bot: {str(e)}'
        }), 500


