# Utility to update positions.json from reconciliation
def resync_positions_from_reconciliation():
    try:
        # Use the new bulletproof reconciliation system to get the latest open positions
        from bot.reconciliation import get_reconciliation_engine
        engine = get_reconciliation_engine()
        result = engine.reconcile(force_refresh=True)
        if result.get('status') != 'success':
            return False, f"Reconciliation failed: {result.get('error', 'Unknown error')}"
        # Extract open positions from reconciliation records
        open_positions = []
        for rec in result.get('records', []):
            # Only include open positions (exchange or bot status)
            if rec.get('exchange_status') == 'open' or rec.get('bot_status') == 'open':
                # Map to positions.json format (minimal fields)
                open_positions.append({
                    'id': rec.get('order_id', rec.get('id', 'unknown')),
                    'entry_price': rec.get('entry_price', 0),
                    'current_price': rec.get('current_price', 0),
                    'size': rec.get('size', 1),
                    'status': 'open',
                    'symbol': rec.get('symbol', ''),
                    'entry_time': rec.get('entry_time', ''),
                })
        # Write to positions.json (mode-specific)
        positions_file = get_mode_specific_file("positions.json")
        payload = {
            'positions': open_positions,
            'summary': {'total_positions': len(open_positions)}
        }
        atomic_write_json(positions_file, payload, indent=2, ensure_ascii=False)
        POSITIONS_CACHE.invalidate()
        return True, f"Resynced {len(open_positions)} open positions."
    except Exception as e:
        return False, str(e)

