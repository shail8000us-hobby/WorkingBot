def start_bot(with_monitor=True):
    """Start the bot process
    
    Args:
        with_monitor: If True, starts heartbeat monitor first (RECOMMENDED)
    """
    global bot_process, bot_process_log_handle, bot_pid_file_handle
    
    if is_bot_running():
        return {'success': False, 'message': 'Bot is already running'}

    try:
        bot_pid_lock = _acquire_bot_pid_lock()
    except ProcessAlreadyRunning as exc:
        existing_pid = exc.args[0] if exc.args else None
        message = f'Bot is already running (pid {existing_pid})' if existing_pid else 'Bot is already running'
        return {'success': False, 'message': message}
    except Exception as exc:
        return {'success': False, 'message': f'Failed to acquire bot PID lock: {exc}'}

    bot_pid_file_handle = bot_pid_lock
    
    try:
        # Check if heartbeat is enabled in config
        heartbeat_enabled = False
        try:
            config_file = BASE_DIR / 'grid_config.env'
            if config_file.exists():
                with open(config_file, 'r') as f:
                    for line in f:
                        if line.strip().startswith('ENABLE_HEARTBEAT='):
                            value = line.split('=')[1].strip().lower()
                            heartbeat_enabled = value in ['true', 'yes', '1', 'on']
                            break
        except Exception:
            pass
        
        # Start monitor first if heartbeat is enabled and requested
        monitor_started = False
        if heartbeat_enabled and with_monitor:
            if not is_monitor_running():
                monitor_result = start_monitor()
                if monitor_result['success']:
                    monitor_started = True
                    time.sleep(2)  # Give monitor time to initialize
                else:
                    _release_bot_pid_lock(remove_file=True)
                    return {
                        'success': False, 
                        'message': f"⚠️ Failed to start monitor: {monitor_result['message']}"
                    }
            else:
                monitor_started = True  # Already running
        
        # Start bot using UNIFIED LAUNCHER (single source of truth)
        # The launcher handles PID file creation and daemon mode
        try:
            result = subprocess.run(
                [sys.executable, 'bot_launcher.py', '--daemon'],
                cwd=str(BASE_DIR),
                capture_output=True,
                text=True,
                env=os.environ.copy()
            )
            
            if result.returncode != 0:
                _release_bot_pid_lock(remove_file=True)
                return {'success': False, 'message': f'Launcher failed: {result.stderr}'}
            
            # Launcher succeeded, get PID from PID file
            time.sleep(3)  # Give launcher more time to create PID file
            pid = get_bot_pid()
            if not pid:
                _release_bot_pid_lock(remove_file=True)
                return {'success': False, 'message': 'Bot started but PID file not found'}
            
            # Store the PID for tracking (but we don't manage the process directly)
            bot_process = None  # Launcher manages the process
            
        except Exception as e:
            _release_bot_pid_lock(remove_file=True)
            return {'success': False, 'message': f'Failed to start bot: {str(e)}'}

        global bot_process_log_handle
        bot_process_log_handle = None  # Launcher handles logging
        
        # Give it a moment to start
        time.sleep(3)
        
        # Check if process is still alive (using PID since launcher manages the process)
        if not is_bot_running():
            _release_bot_pid_lock(remove_file=True)
            _close_bot_log_handle()
            return {'success': False, 'message': 'Bot started but is not running (check logs for errors)'}
        
        # Process is running - get the PID from the PID file
        pid = get_bot_pid()

        if bot_pid_file_handle:
            try:
                bot_pid_file_handle.seek(0)
                bot_pid_file_handle.truncate()
                bot_pid_file_handle.write(f"{pid}\n")
                bot_pid_file_handle.flush()
                os.fsync(bot_pid_file_handle.fileno())
            except Exception as exc:
                print(f"⚠️  Failed to persist bot PID file: {exc}")

        # Build success message
        message = 'Bot started successfully'
        if heartbeat_enabled and monitor_started:
            message += ' ✅ Heartbeat monitor is protecting your bot!'
        elif heartbeat_enabled and not monitor_started:
            message += ' ⚠️ Warning: Heartbeat enabled but monitor not running!'
        
        socketio.emit('bot_status', {
            'running': True, 
            'pid': pid,
            'monitor_running': is_monitor_running()
        })
        
        return {'success': True, 'message': message, 'pid': pid}
            
    except Exception as e:
        _release_bot_pid_lock(remove_file=True)
        _close_bot_log_handle()
        return {'success': False, 'message': f'Error starting bot: {str(e)}'}


def stop_bot(stop_monitor_too=True):
    """Stop the bot process using UNIFIED STOPPER
    
    Args:
        stop_monitor_too: If True, also stops the heartbeat monitor (RECOMMENDED)
    """
    global bot_process
    
    pid = get_bot_pid()
    if not pid:
        return {'success': False, 'message': 'Bot is not running'}
    
    try:
        # Use UNIFIED STOPPER for graceful shutdown
        result = subprocess.run(
            [sys.executable, 'bot_stopper.py', '--graceful'],
            cwd=str(BASE_DIR),
            capture_output=True,
            text=True
        )
        
        success = result.returncode == 0
        
        # Stopper handles everything, just check if it worked
        if not is_bot_running():
            message = 'Bot stopped gracefully'
            
            # Stop monitor if requested
            if stop_monitor_too and is_monitor_running():
                monitor_result = stop_monitor()
                if monitor_result['success']:
                    message += ' ✅ Monitor stopped'
            
            socketio.emit('bot_status', {
                'running': False,
                'pid': None,
                'monitor_running': is_monitor_running()
            })
            _release_bot_pid_lock(remove_file=True)
            _close_bot_log_handle()
            bot_process = None
            return {'success': True, 'message': message}
        else:
            return {'success': False, 'message': 'Bot did not stop'}
        
        # Wait up to 30 seconds for graceful shutdown (increased from 5)
        for _ in range(60):
            time.sleep(0.5)
            if not is_bot_running():
                # Bot stopped successfully
                message = 'Bot stopped gracefully'
                
                # Stop monitor if requested and running
                if stop_monitor_too and is_monitor_running():
                    monitor_result = stop_monitor()
                    if monitor_result['success']:
                        message += ' ✅ Monitor stopped'
                    else:
                        message += ' ⚠️ Monitor still running (manual stop may be needed)'
                
                socketio.emit('bot_status', {
                    'running': False, 
                    'pid': None,
                    'monitor_running': is_monitor_running()
                })
                _release_bot_pid_lock(remove_file=True)
                _close_bot_log_handle()
                bot_process = None
                return {'success': True, 'message': message}
        
        # Force kill if still running
        os.kill(pid, signal.SIGKILL)
        time.sleep(1)
        
        if not is_bot_running():
            message = 'Bot stopped (force killed)'
            
            # Stop monitor if requested and running
            if stop_monitor_too and is_monitor_running():
                monitor_result = stop_monitor()
                if monitor_result['success']:
                    message += ' ✅ Monitor stopped'
            
            socketio.emit('bot_status', {
                'running': False, 
                'pid': None,
                'monitor_running': is_monitor_running()
            })
            _release_bot_pid_lock(remove_file=True)
            _close_bot_log_handle()
            bot_process = None
            return {'success': True, 'message': message}
        else:
            return {'success': False, 'message': 'Failed to stop bot'}
            
    except Exception as e:
        return {'success': False, 'message': f'Error stopping bot: {str(e)}'}


def get_bot_status():
    """Get current bot status"""
    running = is_bot_running()
    pid = get_bot_pid() if running else None
    monitor_running = is_monitor_running()
    guardian_running = is_guardian_running()
    
    # Get mode-specific file paths
    positions_file = get_mode_specific_file("positions.json")
    state_file = get_mode_specific_file("state.json")
    
    # Get state info from positions.json (more accurate than state.json)
    state_info = {}
    open_positions_count = 0
    pending_orders_count = 0
    
    # Try to get positions from positions.json first
    if positions_file.exists():
        try:
            positions_data = load_positions_file(positions_file)
            positions = positions_data.get('positions', [])
            open_positions_count = len([p for p in positions if p.get('status') == 'open'])
        except Exception as e:
            print(f"Error reading {positions_file.name}: {e}")
    
    # Try to get pending orders from state.json
    if state_file.exists():
        try:
            state_data = load_state_file(state_file)
            if state_data.get('pending_buy'):
                pending_orders_count = 1
            if open_positions_count == 0 and 'open_tranches' in state_data:
                open_positions_count = len(state_data.get('open_tranches', []))
        except Exception as e:
            print(f"Error reading {state_file.name}: {e}")
    
    # Check heartbeat status
    heartbeat_status = None
    heartbeat_file = BASE_DIR / '.heartbeat'
    if heartbeat_file.exists():
        try:
            with open(heartbeat_file, 'r') as f:
                heartbeat_data = json.load(f)
                heartbeat_status = {
                    'timestamp': heartbeat_data.get('timestamp'),
                    'status': heartbeat_data.get('status'),
                    'pid': heartbeat_data.get('pid'),
                }
        except Exception:
            pass
    
    # Check Guardian health
    guardian_health = get_guardian_health() if guardian_running else None
    
    # Final fallback: If Trading Bot has no positions, use Guardian Bot's count
    # (Guardian queries exchange directly, so it sees all positions)
    if open_positions_count == 0 and guardian_health and 'monitoring' in guardian_health:
        guardian_position_count = guardian_health['monitoring'].get('position_count', 0)
        if guardian_position_count > 0:
            open_positions_count = guardian_position_count
            # print(f"Using Guardian position count: {guardian_position_count} (Trading Bot not tracking)")  # DISABLED - floods logs
    
    state_info = {
        'open_tranches': open_positions_count,
        'pending_buy': pending_orders_count > 0,
    }
    
    # Get trading mode
    trading_mode_info = None
    try:
        from bot.utils.env_loader import get_current_mode, get_mode_display_info
        mode = get_current_mode()
        mode_info = get_mode_display_info()
        trading_mode_info = {
            'mode': mode,
            'emoji': mode_info['emoji'],
            'description': mode_info['description'],
            'api_url': mode_info['api_url'],
            'risk_level': mode_info['risk_level']
        }
    except Exception as e:
        print(f"Error getting trading mode: {e}")
    
    return {
        'running': running,
        'pid': pid,
        'monitor_running': monitor_running,
        'guardian_running': guardian_running,
        'heartbeat': heartbeat_status,
        'guardian_health': guardian_health,
        'trading_mode': trading_mode_info,
        'state': state_info,
        'uptime': None  # TODO: Calculate from log timestamps
    }


