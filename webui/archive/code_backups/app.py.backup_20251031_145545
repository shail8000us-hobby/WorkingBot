# Simple in-memory rate limiter: {ip: [(timestamp, endpoint), ...]}
_rate_limit_store = defaultdict(list)
_rate_limit_lock = Lock()

def rate_limit(max_requests=10, window_seconds=60):
    """Decorator for rate limiting (per IP)"""
    def decorator(f):
        from functools import wraps
        @wraps(f)
        def wrapped(*args, **kwargs):
            ip = request.remote_addr
            now = datetime.now()
            endpoint = request.endpoint
            
            with _rate_limit_lock:
                # Clean old entries
                _rate_limit_store[ip] = [
                    (ts, ep) for ts, ep in _rate_limit_store[ip]
                    if now - ts < timedelta(seconds=window_seconds)
                ]
                
                # Check limit
                recent = [ep for ts, ep in _rate_limit_store[ip] if ep == endpoint]
                if len(recent) >= max_requests:
                    return jsonify({
                        'success': False,
                        'error': f'Rate limit exceeded: max {max_requests} requests per {window_seconds}s'
                    }), 429
                
                # Record this request
                _rate_limit_store[ip].append((now, endpoint))
            
            return f(*args, **kwargs)
        return wrapped
    return decorator


