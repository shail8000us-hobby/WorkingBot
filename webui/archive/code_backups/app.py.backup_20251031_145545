def _record_legacy_usage(key: str) -> None:
    if not REFACTOR_COMPAT_ENABLED:
        return
    legacy_key_used(key)
    LEGACY_USAGE_COUNTER[key] += 1


def _is_secret_key(key: Optional[str]) -> bool:
    """Determine if the provided configuration key represents a secret."""
    if not key:
        return False
    return bool(SECRET_KEY_PATTERN.search(key))


def _resolved_secret_value(key: str, fallback: Optional[str]) -> Optional[str]:
    """Fetch secret value from env (preferred) with config file fallback."""
    env_value = os.getenv(key)
    if env_value is not None:
        return env_value
    return fallback


def _redact_structured_config(config: Dict[str, Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    """Return a copy of the structured config with secret values redacted."""
    redacted: Dict[str, Dict[str, Any]] = {}
    for key, payload in config.items():
        entry = dict(payload)
        raw_value = entry.get('value')
        if _is_secret_key(key):
            resolved_value = _resolved_secret_value(key, raw_value)
            has_value = bool(resolved_value)
            entry['value'] = REDACTED_PLACEHOLDER if has_value else ""
            entry['redacted'] = True
            entry['has_value'] = has_value
        redacted[key] = entry
    return redacted


def _redact_flat_config(config: Dict[str, str]) -> Dict[str, str]:
    """Return a copy of the flat config with secrets masked."""
    masked: Dict[str, str] = {}
    for key, value in config.items():
        if _is_secret_key(key):
            resolved_value = _resolved_secret_value(key, value)
            masked[key] = REDACTED_PLACEHOLDER if resolved_value else ""
        else:
            masked[key] = value
    return masked


def _atomic_write_text(target_path: Path, content: str) -> None:
    """Atomically persist text content to disk."""
    target = Path(target_path)
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp_name = None
    try:
        with tempfile.NamedTemporaryFile(
            mode='w',
            encoding='utf-8',
            dir=str(target.parent),
            delete=False
        ) as tmp:
            tmp_name = tmp.name
            tmp.write(content)
            tmp.flush()
            os.fsync(tmp.fileno())
        os.replace(tmp_name, target)
    except Exception as exc:
        if tmp_name and os.path.exists(tmp_name):
            os.unlink(tmp_name)
        raise RuntimeError(f"Failed to write text atomically to {target}") from exc


def _normalize_config_entries(config: Dict[str, Dict[str, Any]]) -> Dict[str, Dict[str, Any]]:
    """Normalize configuration keys to canonical GRIDBOT_* equivalents."""
    normalized: Dict[str, Dict[str, Any]] = {}

    for key, payload in config.items():
        canonical_key = LEGACY_TO_CANONICAL.get(key, key)
        entry = dict(payload)
        entry['source_key'] = key
        if key != canonical_key:
            _record_legacy_usage(key)
            entry['deprecated'] = True
            entry.setdefault('legacy_sources', []).append(key)
            if REFACTOR_COMPAT_ENABLED and key not in LEGACY_WARNED_KEYS:
                print(f"⚠️  Deprecated config key '{key}' detected; mapping to '{canonical_key}'.")
                LEGACY_WARNED_KEYS.add(key)
        else:
            entry.setdefault('legacy_sources', [])

        existing = normalized.get(canonical_key)
        if existing:
            # Canonical key already seen.
            if key == canonical_key:
                # Canonical overrides previous legacy entry.
                legacy_sources = existing.get('legacy_sources', [])
                if legacy_sources:
                    entry['legacy_sources'] = sorted(set(entry.get('legacy_sources', []) + legacy_sources))
                if existing.get('source_key') != canonical_key:
                    warning_key = (canonical_key, existing.get('source_key', ''))
                    if REFACTOR_COMPAT_ENABLED and warning_key not in NORMALIZATION_WARNINGS:
                        print(f"⚠️  Canonical key '{canonical_key}' overrides legacy key '{existing.get('source_key')}'.")
                        NORMALIZATION_WARNINGS.add(warning_key)
                normalized[canonical_key] = entry
            else:
                # Additional legacy entry; keep canonical value but track alias.
                legacy_sources = existing.setdefault('legacy_sources', [])
                if key not in legacy_sources:
                    legacy_sources.append(key)
                if str(existing.get('value')) != str(entry.get('value')):
                    warning_key = (canonical_key, key)
                    if REFACTOR_COMPAT_ENABLED and warning_key not in NORMALIZATION_VALUE_WARNINGS:
                        print(
                            f"⚠️  Value mismatch for '{canonical_key}': canonical/active value {existing.get('value')} vs legacy {key}={entry.get('value')}"
                        )
                        NORMALIZATION_VALUE_WARNINGS.add(warning_key)
        else:
            normalized[canonical_key] = entry

    return normalized


def parse_config_file():
    """Parse grid_config.env into structured format"""
    if not CONFIG_FILE.exists():
        return {}
    
    config = {}
    current_section = "General"
    
    with open(CONFIG_FILE, 'r') as f:
        for line in f:
            original_line = line
            line = line.strip()
            
            # Skip empty lines
            if not line:
                continue
            
            # Check for section headers (format: # 1. SECTION NAME or # 9.1 SECTION NAME)
            if line.startswith('#'):
                # Remove the # and strip
                comment_text = line[1:].strip()
                # Check if it starts with a number followed by dot (like "1." or "9.1")
                import re
                if re.match(r'^\d+\.?\d*\s+[A-Z]', comment_text):
                    # Extract section name (everything after the number)
                    section_match = re.match(r'^\d+\.?\d*\s+(.+)', comment_text)
                    if section_match:
                        current_section = section_match.group(1).strip()
                continue
            
            # Parse key=value (only non-comment lines)
            if '=' in line and not line.startswith('#'):
                # Split only on first =
                parts = line.split('=', 1)
                if len(parts) == 2:
                    key = parts[0].strip()
                    value_with_comment = parts[1].strip()
                    
                    # Remove inline comments
                    if '#' in value_with_comment:
                        value = value_with_comment.split('#')[0].strip()
                    else:
                        value = value_with_comment
                    
                    # Remove quotes
                    if value.startswith('"') and value.endswith('"'):
                        value = value[1:-1]
                    elif value.startswith("'") and value.endswith("'"):
                        value = value[1:-1]
                    
                    # Only add valid keys (uppercase with underscores)
                    if key and key.replace('_', '').replace('-', '').isalnum():
                        config[key] = {
                            'value': value,
                            'section': current_section
                        }
    
    return config


def get_structured_config(redact: bool = False, normalize: bool = False) -> Dict[str, Dict[str, Any]]:
    """Return structured configuration, optionally normalized and redacted."""
    config = parse_config_file()
