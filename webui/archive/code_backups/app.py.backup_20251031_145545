class ConfigFileHandler(FileSystemEventHandler):
    """Watch for changes to grid_config.env"""
    
    def __init__(self):
        self.last_modified = 0
    
    def on_modified(self, event):
        if event.src_path == str(CONFIG_FILE):
            # Debounce rapid changes
            now = time.time()
            if now - self.last_modified < 0.5:
                return
            
            # Don't emit if we just wrote the file
            if now - last_config_update < 1.0:
                return
            
            self.last_modified = now
            print(f"Config file changed externally, notifying clients...")
            
            # Reload and broadcast
            new_config = get_structured_config(redact=True, normalize=True)
            socketio.emit('config_updated', new_config)


class CacheInvalidationHandler(FileSystemEventHandler):
    """Invalidate hot caches when monitored files change."""

    def __init__(self, path_callbacks: Dict[Path, Callable[[], None]]):
        self.callbacks = {str(Path(path).resolve()): callback for path, callback in path_callbacks.items()}

    def _trigger(self, path: str) -> None:
        resolved = str(Path(path).resolve())
        callback = self.callbacks.get(resolved)
        if callback:
            callback()

    def on_modified(self, event):
        if not event.is_directory:
            self._trigger(event.src_path)

    def on_created(self, event):
        if not event.is_directory:
            self._trigger(event.src_path)

    def on_moved(self, event):
        if not event.is_directory:
            self._trigger(event.dest_path)


def start_file_watcher():
    """Start watching grid_config.env for external changes"""
    event_handler = ConfigFileHandler()
    observer = Observer()
    observer.schedule(event_handler, str(BASE_DIR), recursive=False)

    cache_handler = CacheInvalidationHandler({
        STATE_FILE: STATE_CACHE.invalidate,
        POSITIONS_FILE: POSITIONS_CACHE.invalidate,
    })
    observer.schedule(cache_handler, str(BASE_DIR), recursive=False)
    observer.start()
    print(f"Watching {CONFIG_FILE} for changes...")
    return observer


