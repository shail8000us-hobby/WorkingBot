{
  "name": "gridbot-webui",
  "version": "1.0.0",
  "description": "GridBot Web UI - Real-time bot control and monitoring",
  "private": true,
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@fontsource-variable/inter": "^5.0.19",
    "@fontsource-variable/roboto-mono": "^5.0.19",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.14.0",
    "axios": "^1.6.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^10.18.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.437.0",
    "monaco-editor": "^0.54.0",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.9.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^13.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "prebuild": "rm -rf build",
    "build": "react-app-rewired build",
    "test": "react-app-rewired test",
    "eject": "react-scripts eject",
    "dev": "react-app-rewired start",
    "help:build": "cd ../.. && python3 tools/help/extract_help_metadata.py",
    "help:watch": "echo 'Help watch mode - run help:build after making changes'",
    "help:validate": "node tools/validate_help_coverage.js || echo 'Validation script not yet created'",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings 200",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,css,md}\"",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all",
      "safari >= 14"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5555",
  "devDependencies": {
    "@storybook/addon-essentials": "^7.6.21",
    "@storybook/addon-links": "^7.6.21",
    "@storybook/react": "^7.6.21",
    "@storybook/react-webpack5": "^7.6.21",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "compression-webpack-plugin": "^11.1.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "postcss": "^8.4.47",
    "prettier": "^3.8.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "source-map-explorer": "^2.5.3",
    "tailwindcss": "^3.4.13",
    "terser-webpack-plugin": "^5.3.14",
    "typescript": "^5.4.5",
    "vite": "^5.4.21",
    "vite-plugin-compression": "^0.5.1"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.test.{js,jsx,ts,tsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/**/*.d.ts"
    ],
    "coverageThresholds": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 50,
        "statements": 50
      }
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "src/**/*.{css,md}": [
      "prettier --write"
    ]
  }
}
