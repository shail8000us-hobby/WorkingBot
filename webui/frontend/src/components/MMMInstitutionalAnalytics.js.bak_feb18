import React, { useState, useEffect } from 'react';
import {
  Box,
  Paper,
  Typography,
  Grid,
  Alert,
  Divider,
  Chip,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  CircularProgress,
} from '@mui/material';
import TrendingUpIcon from '@mui/icons-material/TrendingUp';
import TrendingDownIcon from '@mui/icons-material/TrendingDown';
import WarningAmberIcon from '@mui/icons-material/WarningAmber';
import CheckCircleIcon from '@mui/icons-material/CheckCircle';
import ShowChartIcon from '@mui/icons-material/ShowChart';
import AccountBalanceIcon from '@mui/icons-material/AccountBalance';
import mmmService from './mmm/mmmService';

/**
 * Institutional-Grade Analytics Dashboard
 * 
 * Provides actionable business intelligence for scaling decisions:
 * - Capital requirements optimization
 * - Risk probability assessment  
 * - Strategy validation metrics
 */
const MMMInstitutionalAnalytics = () => {
  const [analytics, setAnalytics] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    fetchAnalytics();
    const interval = setInterval(fetchAnalytics, 60000); // Refresh every minute
    return () => clearInterval(interval);
  }, []);

  const fetchAnalytics = async () => {
    try {
      const data = await mmmService.getAggregatedAnalytics();
      if (data.success) {
        setAnalytics(data.aggregated);
        setError(null);
      } else {
        setError('Failed to load analytics');
      }
    } catch (err) {
      setError(err.message || 'Failed to fetch analytics');
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
        <CircularProgress />
      </Box>
    );
  }

  if (error) {
    return <Alert severity="error">{error}</Alert>;
  }

  if (!analytics || analytics.metadata.total_sessions_analyzed === 0) {
    return (
      <Alert severity="info" icon={<ShowChartIcon />}>
        No historical data yet. Run a few sessions to generate analytics.
      </Alert>
    );
  }

  const { overview, capital_requirements, risk_analytics, profitability, strategy_performance, recent_sessions } = analytics;

  return (
    <Box>
      {/* Header */}
      <Box mb={3}>
        <Typography variant="h4" gutterBottom sx={{ fontWeight: 600, color: '#00d4ff' }}>
          <AccountBalanceIcon sx={{ mr: 1, verticalAlign: 'middle' }} />
          Institutional-Grade Analytics
        </Typography>
        <Typography variant="body2" color="text.secondary">
          Data-driven insights from {overview.total_sessions} sessions •{' '}
          Updated {new Date(analytics.metadata.generated_at).toLocaleString()}
        </Typography>
      </Box>

      {/* Overview Cards */}
      <Grid container spacing={2} mb={3}>
        <Grid item xs={12} md={3}>
          <MetricCard
            title="Total Sessions"
            value={overview.total_sessions}
            icon={<ShowChartIcon />}
            color="#00d4ff"
          />
        </Grid>
        <Grid item xs={12} md={3}>
          <MetricCard
            title="Win Rate"
            value={`${overview.win_rate_pct}%`}
            subtitle={`${overview.profitable_sessions} wins / ${overview.losing_sessions} losses`}
            icon={overview.win_rate_pct >= 70 ? <CheckCircleIcon /> : <WarningAmberIcon />}
            color={overview.win_rate_pct >= 70 ? '#4caf50' : '#ff9800'}
          />
        </Grid>
        <Grid item xs={12} md={3}>
          <MetricCard
            title="Total P&L"
            value={`$${overview.total_pnl.toFixed(2)}`}
            subtitle={`Avg: $${overview.average_pnl_per_session.toFixed(2)}`}
            icon={overview.total_pnl >= 0 ? <TrendingUpIcon /> : <TrendingDownIcon />}
            color={overview.total_pnl >= 0 ? '#4caf50' : '#f44336'}
          />
        </Grid>
        <Grid item xs={12} md={3}>
          <MetricCard
            title="Auto-Close Risk"
            value={`${risk_analytics.auto_close_probability_pct}%`}
            subtitle={`${risk_analytics.sessions_with_auto_close} / ${overview.total_sessions} sessions`}
            icon={<WarningAmberIcon />}
            color={risk_analytics.auto_close_probability_pct > 10 ? '#f44336' : '#4caf50'}
          />
        </Grid>
      </Grid>

      {/* Capital Requirements Section */}
      <Paper sx={{ p: 3, mb: 3, backgroundColor: '#1e1e1e' }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#00d4ff', fontWeight: 600 }}>
          💰 Capital Requirements Analysis
        </Typography>
        <Typography variant="body2" color="text.secondary" mb={2}>
          Critical data for scaling decisions
        </Typography>
        <Divider sx={{ mb: 2 }} />

        <Grid container spacing={3}>
          <Grid item xs={12} md={6}>
            <Box>
              <Typography variant="subtitle2" color="text.secondary" gutterBottom>
                Maximum Exposure Ever Observed
              </Typography>
              <Box display="flex" gap={3} mt={1}>
                <Box>
                  <Typography variant="h4" color="#ff6b6b">
                    {capital_requirements.max_ce_lots_ever}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    CE Lots
                  </Typography>
                </Box>
                <Box>
                  <Typography variant="h4" color="#4dabf7">
                    {capital_requirements.max_pe_lots_ever}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    PE Lots
                  </Typography>
                </Box>
                <Box>
                  <Typography variant="h4" color="#ffd43b">
                    {capital_requirements.max_combined_lots_ever}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    Total Lots
                  </Typography>
                </Box>
              </Box>
            </Box>
          </Grid>

          <Grid item xs={12} md={6}>
            <Box>
              <Typography variant="subtitle2" color="text.secondary" gutterBottom>
                Average Peak Exposure
              </Typography>
              <Box display="flex" gap={3} mt={1}>
                <Box>
                  <Typography variant="h5" color="#ff6b6b">
                    {capital_requirements.avg_peak_ce_lots}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    Avg CE
                  </Typography>
                </Box>
                <Box>
                  <Typography variant="h5" color="#4dabf7">
                    {capital_requirements.avg_peak_pe_lots}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    Avg PE
                  </Typography>
                </Box>
                <Box>
                  <Typography variant="h5" color="#ffd43b">
                    {capital_requirements.avg_peak_combined_lots}
                  </Typography>
                  <Typography variant="caption" color="text.secondary">
                    Avg Total
                  </Typography>
                </Box>
              </Box>
            </Box>
          </Grid>

          <Grid item xs={12}>
            <Alert severity="warning" icon={<AccountBalanceIcon />}>
              <Typography variant="body2" sx={{ fontWeight: 600 }}>
                Scaling Guidance:
              </Typography>
              <Typography variant="body2">
                {capital_requirements.scaling_guidance}
              </Typography>
              <Typography variant="caption" display="block" mt={1}>
                Capital Multiplier: <strong>{capital_requirements.capital_multiplier}x</strong> from starting position to peak
              </Typography>
            </Alert>
          </Grid>
        </Grid>
      </Paper>

      {/* Profitability Section */}
      <Paper sx={{ p: 3, mb: 3, backgroundColor: '#1e1e1e' }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#00d4ff', fontWeight: 600 }}>
          📊 Profitability Metrics
        </Typography>
        <Divider sx={{ mb: 2 }} />

        <Grid container spacing={2}>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Best Session" value={`$${profitability.best_session_pnl.toFixed(2)}`} positive />
          </Grid>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Worst Session" value={`$${profitability.worst_session_pnl.toFixed(2)}`} negative />
          </Grid>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Average P&L" value={`$${profitability.average_pnl.toFixed(2)}`} />
          </Grid>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Median P&L" value={`$${profitability.median_pnl.toFixed(2)}`} />
          </Grid>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Avg Win" value={`$${profitability.avg_win_amount.toFixed(2)}`} positive />
          </Grid>
          <Grid item xs={6} sm={4} md={2}>
            <StatBox label="Avg Loss" value={`$${profitability.avg_loss_amount.toFixed(2)}`} negative />
          </Grid>
        </Grid>

        <Box mt={2}>
          <Typography variant="body2" color="text.secondary">
            Profit Factor:{' '}
            <Chip
              label={profitability.profit_factor.toFixed(2)}
              size="small"
              color={profitability.profit_factor > 1.5 ? 'success' : profitability.profit_factor > 1 ? 'warning' : 'error'}
              sx={{ ml: 1 }}
            />
            <Typography component="span" variant="caption" color="text.secondary" ml={1}>
              (Ratio of total wins to total losses)
            </Typography>
          </Typography>
        </Box>
      </Paper>

      {/* Strategy Performance Section */}
      <Paper sx={{ p: 3, mb: 3, backgroundColor: '#1e1e1e' }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#00d4ff', fontWeight: 600 }}>
          ⚙️ Strategy Performance
        </Typography>
        <Divider sx={{ mb: 2 }} />

        <Grid container spacing={2}>
          <Grid item xs={6} md={3}>
            <StatBox
              label="Avg Adjustments"
              value={strategy_performance.avg_adjustments_per_session}
              subtitle={`${strategy_performance.total_adjustments} total`}
            />
          </Grid>
          <Grid item xs={6} md={3}>
            <StatBox
              label="Avg Reversals"
              value={strategy_performance.avg_reversals_per_session}
              subtitle={`${strategy_performance.total_reversals} total`}
            />
          </Grid>
          <Grid item xs={6} md={3}>
            <StatBox
              label="CE Adjustments"
              value={strategy_performance.total_ce_adjustments}
            />
          </Grid>
          <Grid item xs={6} md={3}>
            <StatBox
              label="PE Adjustments"
              value={strategy_performance.total_pe_adjustments}
            />
          </Grid>
        </Grid>

        <Box mt={2}>
          <Typography variant="body2" color="text.secondary">
            Total Volume Traded: <strong>{strategy_performance.total_volume} lots</strong>
            {' '}({strategy_performance.total_ce_lots_traded} CE, {strategy_performance.total_pe_lots_traded} PE)
          </Typography>
        </Box>
      </Paper>

      {/* Risk Analytics Section */}
      <Paper sx={{ p: 3, mb: 3, backgroundColor: '#1e1e1e' }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#00d4ff', fontWeight: 600 }}>
          ⚠️ Risk Analytics
        </Typography>
        <Divider sx={{ mb: 2 }} />

        <Grid container spacing={2}>
          <Grid item xs={12} md={6}>
            <Box p={2} sx={{ backgroundColor: '#2a2a2a', borderRadius: 1 }}>
              <Typography variant="subtitle2" color="text.secondary" gutterBottom>
                Drawdown Analysis
              </Typography>
              <Typography variant="h5" color="#f44336">
                ${risk_analytics.worst_drawdown_ever.toFixed(2)}
              </Typography>
              <Typography variant="caption" color="text.secondary">
                Worst Drawdown Ever
              </Typography>
              <Typography variant="body2" mt={1}>
                Average Max Drawdown: <strong>${risk_analytics.avg_max_drawdown.toFixed(2)}</strong>
              </Typography>
            </Box>
          </Grid>

          <Grid item xs={12} md={6}>
            <Box p={2} sx={{ backgroundColor: '#2a2a2a', borderRadius: 1 }}>
              <Typography variant="subtitle2" color="text.secondary" gutterBottom>
                Completion Rate
              </Typography>
              <Typography variant="h5" color="#4caf50">
                {risk_analytics.completion_rate_pct}%
              </Typography>
              <Typography variant="caption" color="text.secondary">
                Sessions Completed Normally
              </Typography>
              <Typography variant="body2" mt={1}>
                {risk_analytics.normally_completed_sessions} / {overview.total_sessions} sessions
              </Typography>
            </Box>
          </Grid>
        </Grid>
      </Paper>

      {/* Recent Sessions */}
      <Paper sx={{ p: 3, backgroundColor: '#1e1e1e' }}>
        <Typography variant="h6" gutterBottom sx={{ color: '#00d4ff', fontWeight: 600 }}>
          📑 Recent Sessions
        </Typography>
        <Divider sx={{ mb: 2 }} />

        <TableContainer>
          <Table size="small">
            <TableHead>
              <TableRow>
                <TableCell>Session ID</TableCell>
                <TableCell>Expiry</TableCell>
                <TableCell>Status</TableCell>
                <TableCell align="right">Max Lots</TableCell>
                <TableCell align="right">Adjustments</TableCell>
                <TableCell align="right">Final P&L</TableCell>
              </TableRow>
            </TableHead>
            <TableBody>
              {recent_sessions.map((session) => (
                <TableRow key={session.session_id}>
                  <TableCell>{session.session_id}</TableCell>
                  <TableCell>{session.expiry}</TableCell>
                  <TableCell>
                    <Chip label={session.status} size="small" />
                  </TableCell>
                  <TableCell align="right">{session.max_lots}</TableCell>
                  <TableCell align="right">{session.adjustments}</TableCell>
                  <TableCell align="right">
                    <Typography
                      variant="body2"
                      sx={{ color: session.final_pnl >= 0 ? '#4caf50' : '#f44336', fontWeight: 600 }}
                    >
                      ${session.final_pnl.toFixed(2)}
                    </Typography>
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
        </TableContainer>
      </Paper>
    </Box>
  );
};

// Helper Components

const MetricCard = ({ title, value, subtitle, icon, color }) => (
  <Paper
    sx={{
      p: 2,
      height: '100%',
      backgroundColor: '#1e1e1e',
      borderLeft: `4px solid ${color}`,
    }}
  >
    <Box display="flex" alignItems="center" justifyContent="space-between" mb={1}>
      <Typography variant="caption" color="text.secondary">
        {title}
      </Typography>
      <Box sx={{ color }}>{icon}</Box>
    </Box>
    <Typography variant="h4" sx={{ fontWeight: 700, color }}>
      {value}
    </Typography>
    {subtitle && (
      <Typography variant="caption" color="text.secondary">
        {subtitle}
      </Typography>
    )}
  </Paper>
);

const StatBox = ({ label, value, subtitle, positive, negative }) => (
  <Box p={1.5} sx={{ backgroundColor: '#2a2a2a', borderRadius: 1, textAlign: 'center' }}>
    <Typography variant="caption" color="text.secondary" display="block" mb={0.5}>
      {label}
    </Typography>
    <Typography
      variant="h6"
      sx={{
        fontWeight: 600,
        color: positive ? '#4caf50' : negative ? '#f44336' : '#fff',
      }}
    >
      {value}
    </Typography>
    {subtitle && (
      <Typography variant="caption" color="text.secondary" display="block">
        {subtitle}
      </Typography>
    )}
  </Box>
);

export default MMMInstitutionalAnalytics;
