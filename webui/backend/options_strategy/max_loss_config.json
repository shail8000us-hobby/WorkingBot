{
  "max_loss_monitor": {
    "check_interval": 5.0,
    "warning_threshold": 0.8,
    "cache_ttl": 3.0,
    "max_calls_per_minute": 60,
    "test_mode": false,
    "max_retries": 3,
    "retry_backoff_base": 2,
    "websocket": {
      "enabled": true,
      "url": "wss://socket.india.delta.exchange",
      "reconnect_delay": 5,
      "ping_interval": 30
    },
    "notifications": {
      "enabled": false,
      "channels": ["log"],
      "webhook_url": null,
      "telegram_bot_token": null,
      "telegram_chat_id": null
    }
  }
}
