#!/usr/bin/osascript
# GridBot Control Center - Beautiful GUI Launcher

set dialogTitle to "⚡️ GridBot Control Center"
set dialogPrompt to "Choose a monitoring tool to launch:"

set buttonList to {"📊 Status", "🔴 Logs", "📈 Grid", "💻 PM2", "❌ Cancel"}

set userChoice to button returned of (display dialog dialogPrompt with title dialogTitle buttons buttonList default button 1 with icon note)

set scriptDir to "/Users/ssr/Projects/WorkingBot"

if userChoice is "📊 Status" then
    tell application "Terminal"
        activate
        do script "clear && cd '" & scriptDir & "' && ./bot-status.command"
    end tell
    
else if userChoice is "🔴 Logs" then
    tell application "Terminal"
        activate
        do script "cd '" & scriptDir & "' && ./view-logs.command"
    end tell
    
else if userChoice is "📈 Grid" then
    tell application "Terminal"
        activate
        do script "cd '" & scriptDir & "' && ./view-grid-status.command"
    end tell
    
else if userChoice is "💻 PM2" then
    tell application "Terminal"
        activate
        do script "cd '" & scriptDir & "' && ./pm2-monitor.command"
    end tell
    
end if
