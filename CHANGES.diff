## File 5: bot/utils/notifier.py
### Added mode-aware routing, prefixes, and deduplication

```diff
@@ -7,6 +7,7 @@ import urllib.request
 import urllib.parse
 import logging
 from typing import Optional
+from collections import deque
 
 log = logging.getLogger("runner")
 
@@ -14,19 +15,51 @@ log = logging.getLogger("runner")
 class TelegramNotifier:
     """
-    Minimal Telegram sender with retries.
-    Reads token/chat_id from env if not passed.
+    Mode-aware Telegram sender with deduplication.
+    Routes to LIVE or DEMO credentials based on TRADING_MODE.
+    Prefixes messages with [LIVE] or [DEMO].
+    Deduplicates identical messages within 2-second window.
     """
 
     def __init__(self, token: Optional[str] = None, chat_id: Optional[str] = None):
-        self.token = token or os.getenv("TELEGRAM_BOT_TOKEN", "").strip()
-        self.chat_id = chat_id or os.getenv("TELEGRAM_CHAT_ID", "").strip()
+        # Determine mode
+        trading_mode = os.getenv("TRADING_MODE", "demo").lower().strip()
+        self.is_live = (trading_mode == "live")
+        self.mode_prefix = "[LIVE]" if self.is_live else "[DEMO]"
+        
+        # Select mode-specific credentials
+        if token and chat_id:
+            # Explicit override
+            self.token = token
+            self.chat_id = chat_id
+        elif self.is_live:
+            # LIVE mode: use LIVE_TELEGRAM_*
+            self.token = os.getenv("LIVE_TELEGRAM_BOT_TOKEN", "").strip()
+            self.chat_id = os.getenv("LIVE_TELEGRAM_CHAT_ID", "").strip()
+            # Fallback to generic if LIVE-specific not set
+            if not self.token:
+                self.token = os.getenv("TELEGRAM_BOT_TOKEN", "").strip()
+            if not self.chat_id:
+                self.chat_id = os.getenv("TELEGRAM_CHAT_ID", "").strip()
+        else:
+            # DEMO mode: use DEMO_TELEGRAM_*
+            self.token = os.getenv("DEMO_TELEGRAM_BOT_TOKEN", "").strip()
+            self.chat_id = os.getenv("DEMO_TELEGRAM_CHAT_ID", "").strip()
+            # Fallback to generic if DEMO-specific not set
+            if not self.token:
+                self.token = os.getenv("TELEGRAM_BOT_TOKEN", "").strip()
+            if not self.chat_id:
+                self.chat_id = os.getenv("TELEGRAM_CHAT_ID", "").strip()
+        
         self.enabled = os.getenv("NOTIFY_ENABLED", "1") not in (
             "0", "false", "False", "")
 
         if not self.token or not self.chat_id:
             # keep disabled but don't crash the bot
             self.enabled = False
             log.warning(
-                "notifier: disabled (missing TELEGRAM_BOT_TOKEN or TELEGRAM_CHAT_ID)")
+                f"notifier: disabled (missing {self.mode_prefix} Telegram credentials)")
+        else:
+            log.info(f"notifier: {self.mode_prefix} routing enabled")
+        
+        # Deduplication cache: (message_hash, timestamp)
+        self._dedup_cache = deque(maxlen=50)
+        self._dedup_window = 2.0  # seconds
 
-    def send(self, text: str):
+    def _should_send(self, text: str) -> bool:
+        """Check if message should be sent (deduplication)"""
+        now = time.time()
+        msg_hash = hash(text)
+        
+        # Clean old entries
+        while self._dedup_cache and (now - self._dedup_cache[0][1]) > self._dedup_window:
+            self._dedup_cache.popleft()
+        
+        # Check for duplicate
+        for cached_hash, _ in self._dedup_cache:
+            if cached_hash == msg_hash:
+                log.debug(f"notifier: dedup skip (within {self._dedup_window}s)")
+                return False
+        
+        # Add to cache
+        self._dedup_cache.append((msg_hash, now))
+        return True
+    
+    def send(self, text: str, skip_dedup: bool = False):
+        """Send message with mode prefix and deduplication"""
         if not self.enabled:
             return
+        
+        # Add mode prefix
+        prefixed_text = f"{self.mode_prefix} {text}"
+        
+        # Check deduplication (unless explicitly skipped)
+        if not skip_dedup and not self._should_send(prefixed_text):
+            return
+        
         try:
             url = f"https://api.telegram.org/bot{self.token}/sendMessage"
             data = urllib.parse.urlencode(
-                {"chat_id": self.chat_id, "text": text}).encode()
+                {"chat_id": self.chat_id, "text": prefixed_text}).encode()
```

