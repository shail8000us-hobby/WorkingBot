import React, { useState, useEffect } from 'react';
import {
  Box,
  Paper,
  Typography,
  Chip,
  LinearProgress,
  Alert,
  Card,
  CardContent,
  Divider,
  CircularProgress
} from '@mui/material';
import {
  CheckCircle,
  Cancel,
  Warning,
  Timeline,
  TrendingUp,
  Shield,
  AccessTime as Clock,
  GpsFixed as Target
} from '@mui/icons-material';
import { Zap, Brain } from 'lucide-react';
import apiClient from '../utils/apiClient';

const BotStrategyPanel = () => {
  const [strategy, setStrategy] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [lastUpdate, setLastUpdate] = useState(null);

  const fetchStrategy = async () => {
    try {
      const response = await apiClient.get('/api/strategy/current');
      if (response.success) {
        setStrategy(response);
        setLastUpdate(new Date());
        setError(null);
      } else {
        setError(response.error || 'Failed to load strategy');
      }
    } catch (err) {
      console.error('Error fetching strategy:', err);
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchStrategy();
    
    // Auto-refresh every 5 seconds
    const interval = setInterval(fetchStrategy, 5000);
    
    return () => clearInterval(interval);
  }, []);

  const getDecisionIcon = (decision) => {
    switch (decision) {
      case 'PLACE_BUY':
        return <Zap className="text-emerald-400" />;
      case 'VOLATILITY_HALT':
        return <Warning className="text-amber-400" />;
      case 'WAIT_FOR_CLOSE':
        return <Clock className="text-sky-400" />;
      case 'RISK_HALT':
      case 'LIQUIDATION_RISK':
        return <Shield className="text-rose-400" />;
      default:
        return <Timeline className="text-slate-400" />;
    }
  };

  const getDecisionColor = (decision) => {
    switch (decision) {
      case 'PLACE_BUY':
        return 'success';
      case 'VOLATILITY_HALT':
        return 'warning';
      case 'RISK_HALT':
      case 'LIQUIDATION_RISK':
        return 'error';
      default:
        return 'info';
    }
  };

  const getStatusIcon = (result) => {
    switch (result) {
      case 'PASS':
        return <CheckCircle className="text-emerald-400" fontSize="small" />;
      case 'BLOCK':
        return <Cancel className="text-rose-400" fontSize="small" />;
      case 'WAIT':
        return <Warning className="text-amber-400" fontSize="small" />;
      default:
        return null;
    }
  };

  if (loading && !strategy) {
    return (
      <Box className="flex items-center justify-center py-20">
        <CircularProgress size={40} />
        <Typography className="ml-4 text-slate-400">
          Analyzing bot strategy...
        </Typography>
      </Box>
    );
  }

  if (error) {
    return (
      <Alert severity="error">
        Failed to load bot strategy: {error}
      </Alert>
    );
  }

  if (!strategy) return null;

  const { market_snapshot, bot_state, safety_status, decision_tree, next_actions } = strategy;
  
  // Determine decision from safety_status
  let decision = 'UNKNOWN';
  if (safety_status?.status === 'UNSAFE' || !safety_status?.is_safe) {
    decision = 'VOLATILITY_HALT';
  } else if (bot_state?.emergency_stop) {
    decision = 'RISK_HALT';
  } else if (bot_state?.open_positions >= bot_state?.max_positions) {
    decision = 'WAIT_FOR_CLOSE';
  } else if (safety_status?.is_safe) {
    decision = 'PLACE_BUY';
  }

  return (
    <div className="space-y-6">
      {/* Header - Current Decision */}
      <Card className="border border-slate-700 bg-gradient-to-br from-slate-900 to-slate-800">
        <CardContent>
          <Box className="flex items-center justify-between mb-4">
            <Box className="flex items-center gap-3">
              <Brain className="text-sky-400" style={{ fontSize: 40 }} />
              <div>
                <Typography variant="h5" className="font-bold text-slate-100">
                  Bot Decision Engine
                </Typography>
                <Typography variant="caption" className="text-slate-400">
                  Live strategy analysis • Updates every 5s
                </Typography>
              </div>
            </Box>
            {lastUpdate && (
              <Typography variant="caption" className="text-slate-500">
                Last update: {lastUpdate.toLocaleTimeString()}
              </Typography>
            )}
          </Box>

          <Divider className="my-4 border-slate-700" />

          {/* Current Decision Status */}
          <Box className="flex items-start gap-4">
            <Box className="p-3 rounded-full bg-slate-800/50">
              {getDecisionIcon(decision)}
            </Box>
            <Box className="flex-1">
              <Chip 
                label={decision.replace(/_/g, ' ')} 
                color={getDecisionColor(decision)}
                size="small"
                className="mb-2"
              />
              <Typography variant="h6" className="text-slate-100 mb-2">
                {decision === 'PLACE_BUY' ? '🎯 Ready to Trade' :
                 decision === 'VOLATILITY_HALT' ? '🛑 Volatility Halt Active' :
                 decision === 'WAIT_FOR_CLOSE' ? '⏸️ At Maximum Capacity' :
                 decision === 'RISK_HALT' ? '⚠️ Risk Halt - High Margin' :
                 decision === 'LIQUIDATION_RISK' ? '🚨 Liquidation Protection Active' :
                 decision === 'WAIT_FOR_GRID_REENTRY' ? '📍 Price Outside Grid' :
                 '⏳ Waiting...'}
              </Typography>
              
              {/* Market Snapshot */}
              <Box className="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4">
                <Box className="p-2 rounded bg-slate-800/50 border border-slate-700">
                  <Typography variant="caption" className="text-slate-400">Current Price</Typography>
                  <Typography variant="body2" className="font-bold text-slate-100">
                    ${market_snapshot?.current_price?.toLocaleString() || '--'}
                  </Typography>
                </Box>
                <Box className="p-2 rounded bg-slate-800/50 border border-slate-700">
                  <Typography variant="caption" className="text-slate-400">Positions</Typography>
                  <Typography variant="body2" className="font-bold text-slate-100">
                    {bot_state?.open_positions || 0}/{bot_state?.max_positions || 3}
                  </Typography>
                </Box>
                <Box className="p-2 rounded bg-slate-800/50 border border-slate-700">
                  <Typography variant="caption" className="text-slate-400">Volatility</Typography>
                  <Typography variant="body2" className="font-bold text-slate-100">
                    {safety_status?.status || 'UNKNOWN'}
                  </Typography>
                </Box>
                <Box className="p-2 rounded bg-slate-800/50 border border-slate-700">
                  <Typography variant="caption" className="text-slate-400">Margin</Typography>
                  <Typography variant="body2" className="font-bold text-slate-100">
                    {safety_status?.margin_utilization?.toFixed(1) || '--'}%
                  </Typography>
                </Box>
              </Box>
            </Box>
          </Box>
        </CardContent>
      </Card>

      {/* Human Explanation */}
      {strategy.human_explanation?.main_explanation && (
        <Card className="border border-slate-700 bg-slate-900">
          <CardContent>
            <Typography variant="h6" className="font-semibold text-slate-100 mb-3 flex items-center gap-2">
              <Target className="text-cyan-400" />
              Strategy Explanation
            </Typography>
            <Box className="p-4 rounded-lg bg-slate-800/50 border border-slate-700">
              <Typography 
                className="text-slate-300 whitespace-pre-line leading-relaxed"
                style={{ fontFamily: 'system-ui', fontSize: '14px', lineHeight: '1.7' }}
              >
                {strategy.human_explanation.main_explanation}
              </Typography>
            </Box>
          </CardContent>
        </Card>
      )}

      {/* Logic Flow - Safety Checks */}
      {strategy.human_explanation?.logic_flow && strategy.human_explanation.logic_flow.length > 0 && (
        <Card className="border border-slate-700 bg-slate-900">
          <CardContent>
            <Typography variant="h6" className="font-semibold text-slate-100 mb-3 flex items-center gap-2">
              <Shield className="text-emerald-400" />
              Safety Checks & Decision Logic
            </Typography>
            <Typography variant="body2" className="text-slate-400 mb-4">
              Every order passes through these checks. All must pass for trading to proceed.
            </Typography>
            
            <div className="space-y-3">
              {strategy.human_explanation.logic_flow.map((check, index) => (
              <Box 
                key={index}
                className="p-3 rounded-lg border"
                style={{
                  borderColor: check.result === 'PASS' ? '#10b981' : 
                               check.result === 'BLOCK' ? '#ef4444' : '#f59e0b',
                  backgroundColor: check.result === 'PASS' ? 'rgba(16, 185, 129, 0.05)' : 
                                  check.result === 'BLOCK' ? 'rgba(239, 68, 68, 0.05)' : 'rgba(245, 158, 11, 0.05)'
                }}
              >
                <Box className="flex items-start gap-3">
                  {getStatusIcon(check.result)}
                  <Box className="flex-1">
                    <Box className="flex items-center gap-2 mb-1">
                      <Typography variant="body2" className="font-semibold text-slate-100">
                        {index + 1}. {check.step}
                      </Typography>
                      <Chip 
                        label={check.status} 
                        size="small"
                        style={{
                          backgroundColor: check.result === 'PASS' ? 'rgba(16, 185, 129, 0.2)' : 
                                          check.result === 'BLOCK' ? 'rgba(239, 68, 68, 0.2)' : 'rgba(245, 158, 11, 0.2)',
                          color: check.result === 'PASS' ? '#10b981' : 
                                 check.result === 'BLOCK' ? '#ef4444' : '#f59e0b'
                        }}
                      />
                    </Box>
                    <Typography variant="body2" className="text-slate-300">
                      {check.explanation}
                    </Typography>
                    {check.details && Object.keys(check.details).length > 0 && (
                      <Box className="mt-2 ml-4 space-y-1">
                        {Object.entries(check.details).map(([key, value]) => (
                          <Typography key={key} variant="caption" className="text-slate-400 block">
                            {value}
                          </Typography>
                        ))}
                      </Box>
                    )}
                  </Box>
                </Box>
              </Box>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      {/* GRID SCENARIOS - THREE Visual Panels */}
      {strategy.grid_scenarios && (
        <Box className="space-y-4 mb-6">
          {/* SCENARIO 1: SAFE - Complete Trading Sequence */}
          {strategy.grid_scenarios.scenario_1_safe && (
            <Card className="border-2 border-emerald-500/50 bg-gradient-to-br from-emerald-900/30 to-slate-900">
            <CardContent>
              <Box className="flex items-center justify-between mb-4">
                <Typography variant="h6" className="font-bold text-emerald-100 flex items-center gap-2">
                  <CheckCircle className="text-emerald-400" />
                  {strategy.grid_scenarios.scenario_1_safe.title}
                </Typography>
                <Box className="flex gap-2">
                  <Chip label={`${strategy.grid_scenarios.scenario_1_safe.total_actions} Actions`} size="small" className="bg-emerald-700 text-emerald-100 font-bold" />
                  <Chip label={`$${strategy.grid_scenarios.scenario_1_safe.summary.total_profit_potential.toLocaleString()} Profit`} size="small" className="bg-emerald-600 text-emerald-100 font-bold" />
                </Box>
              </Box>
              
              <Typography variant="body2" className="text-slate-300 mb-4">
                {strategy.grid_scenarios.scenario_1_safe.description}
              </Typography>
              
              {/* Complete Action Sequence */}
              {strategy.grid_scenarios.scenario_1_safe?.sequence && strategy.grid_scenarios.scenario_1_safe.sequence.length > 0 ? (
                <Box className="space-y-2">
                  <Typography variant="body2" className="text-emerald-200 mb-3 font-semibold flex items-center gap-2">
                    <Timeline className="w-4 h-4" />
                    Complete Action Sequence ({strategy.grid_scenarios.scenario_1_safe.total_actions} steps)
                  </Typography>
                  {strategy.grid_scenarios.scenario_1_safe.sequence.map((action, idx) => (
                    <Box 
                      key={idx}
                      className={`p-3 rounded-lg border ${
                        action.action === 'PLACE_BUY' || action.action === 'PLACE_NEXT_BUY' ? 'bg-emerald-900/30 border-emerald-700/40' :
                        action.action === 'PLACE_TP' ? 'bg-cyan-900/30 border-cyan-700/40' :
                        action.action === 'WAIT_FILL' ? 'bg-yellow-900/20 border-yellow-700/30' :
                        'bg-slate-800/40 border-slate-700/30'
                      }`}
                    >
                      <Box className="flex items-center justify-between mb-1">
                        <Typography variant="subtitle2" className="font-bold text-emerald-100">
                          {action.id}. {action.action.replace(/_/g, ' ')}
                        </Typography>
                        {action.price && (
                          <Chip 
                            label={`$${action.price.toLocaleString()}`}
                            size="small"
                            className="bg-emerald-700 text-emerald-100 font-mono text-xs"
                          />
                        )}
                        {action.profit && (
                          <Chip 
                            label={`Profit: $${action.profit.toFixed(0)}`}
                            size="small"
                            className="bg-cyan-700 text-cyan-100 font-bold text-xs"
                          />
                        )}
                      </Box>
                      
                      <Box className="text-sm space-y-1 ml-2">
                        {action.trigger && (
                          <Typography variant="caption" className="text-slate-400 block">
                            ▸ Trigger: {action.trigger}
                          </Typography>
                        )}
                        {action.outcome && (
                          <Typography variant="caption" className="text-slate-300 block font-medium">
                            ▸ Outcome: {action.outcome}
                          </Typography>
                        )}
                        {action.tp && (
                          <Typography variant="caption" className="text-cyan-300 block">
                            ▸ TP: ${action.tp.toLocaleString()}
                          </Typography>
                        )}
                        {action.protection && (
                          <Typography variant="caption" className="text-cyan-300 block font-medium">
                            ▸ {action.protection}
                          </Typography>
                        )}
                        {action.detection && (
                          <Typography variant="caption" className="text-yellow-300 block">
                            ▸ Detection: {action.detection}
                          </Typography>
                        )}
                        {action.timing && (
                          <Typography variant="caption" className="text-slate-400 block italic">
                            ⏱ {action.timing}
                          </Typography>
                        )}
                      </Box>
                    </Box>
                  ))}
                </Box>
              ) : (
                <Alert severity="info" className="bg-slate-800/50">
                  No sequence available
                </Alert>
              )}
            </CardContent>
          </Card>
          )}

          {/* SCENARIO 2: UNSAFE - Halt Sequence */}
          {strategy.grid_scenarios.scenario_2_unsafe && (
            <Card className="border-2 border-orange-500/50 bg-gradient-to-br from-orange-900/30 to-slate-900">
            <CardContent>
              <Box className="flex items-center justify-between mb-4">
                <Typography variant="h6" className="font-bold text-orange-100 flex items-center gap-2">
                  <Warning className="text-orange-400" />
                  {strategy.grid_scenarios.scenario_2_unsafe.title}
                </Typography>
                <Chip 
                  label={`${strategy.grid_scenarios.scenario_2_unsafe.total_actions} Actions`}
                  size="small" 
                  className="bg-orange-700 text-orange-100 font-bold"
                />
              </Box>
              
              <Typography variant="body2" className="text-slate-300 mb-4">
                {strategy.grid_scenarios.scenario_2_unsafe.description}
              </Typography>
              
              {/* Unsafe Sequence */}
              {strategy.grid_scenarios.scenario_2_unsafe?.sequence && strategy.grid_scenarios.scenario_2_unsafe.sequence.length > 0 && (
                <Box className="space-y-2">
                  <Typography variant="body2" className="text-orange-200 mb-3 font-semibold flex items-center gap-2">
                    <Shield className="w-4 h-4" />
                    Halt & Protection Sequence
                  </Typography>
                  {strategy.grid_scenarios.scenario_2_unsafe.sequence.map((action, idx) => (
                    <Box 
                      key={idx}
                      className={`p-3 rounded-lg border ${
                        action.action.includes('CANCEL') ? 'bg-red-900/30 border-red-700/40' :
                        action.action.includes('RECOVERY') ? 'bg-cyan-900/30 border-cyan-700/40' :
                        action.action.includes('MONITOR') ? 'bg-yellow-900/20 border-yellow-700/30' :
                        'bg-slate-800/40 border-orange-700/30'
                      }`}
                    >
                      <Typography variant="subtitle2" className="font-bold text-orange-100 mb-1">
                        {action.id}. {action.action.replace(/_/g, ' ')}
                      </Typography>
                      
                      <Box className="text-sm space-y-1 ml-2">
                        <Typography variant="caption" className="text-slate-400 block">
                          ▸ Trigger: {action.trigger}
                        </Typography>
                        <Typography variant="caption" className="text-slate-300 block font-medium">
                          ▸ Outcome: {action.outcome}
                        </Typography>
                        {action.verification && (
                          <Typography variant="caption" className="text-cyan-300 block">
                            ▸ Verification: {action.verification}
                          </Typography>
                        )}
                        {action.data_stored && (
                          <Typography variant="caption" className="text-violet-300 block">
                            ▸ Saves: {JSON.stringify(action.data_stored).slice(0, 50)}...
                          </Typography>
                        )}
                        {action.timing && (
                          <Typography variant="caption" className="text-slate-400 block italic">
                            ⏱ {action.timing}
                          </Typography>
                        )}
                        {action.brain_function && (
                          <Typography variant="caption" className="text-purple-300 block font-mono text-xs">
                            🧠 {action.brain_function}
                          </Typography>
                        )}
                      </Box>
                    </Box>
                  ))}
                </Box>
              )}
            </CardContent>
          </Card>
          )}

          {/* SCENARIO 3: RECOVERY - Opportunistic Recovery */}
          {strategy.grid_scenarios.scenario_3_recovery && (
            <Card className="border-2 border-cyan-500/50 bg-gradient-to-br from-cyan-900/30 to-slate-900">
              <CardContent>
                <Box className="flex items-center justify-between mb-4">
                  <Typography variant="h6" className="font-bold text-cyan-100 flex items-center gap-2">
                    <Zap className="text-cyan-400" />
                    {strategy.grid_scenarios.scenario_3_recovery.title}
                  </Typography>
                  <Box className="flex gap-2">
                    <Chip 
                      label={`${strategy.grid_scenarios.scenario_3_recovery.total_actions} Actions`}
                      size="small" 
                      className="bg-cyan-700 text-cyan-100 font-bold"
                    />
                    <Chip 
                      label={`+$${strategy.grid_scenarios.scenario_3_recovery.summary.total_enhanced_profit.toLocaleString()} Enhanced`}
                      size="small" 
                      className="bg-emerald-600 text-emerald-100 font-bold"
                    />
                  </Box>
                </Box>
                
                <Typography variant="body2" className="text-slate-300 mb-4">
                  {strategy.grid_scenarios.scenario_3_recovery.description}
                </Typography>
                
                <Box className="space-y-2">
                  <Typography variant="body2" className="text-cyan-200 mb-3 font-semibold flex items-center gap-2">
                    <Brain className="w-4 h-4" />
                    Opportunistic Recovery Sequence
                  </Typography>
                  {strategy.grid_scenarios.scenario_3_recovery.sequence.map((action, idx) => (
                    <Box 
                      key={idx}
                      className={`p-3 rounded-lg border ${
                        action.action.includes('OPPORTUNISTIC') ? 'bg-emerald-900/30 border-emerald-700/40' :
                        action.action.includes('RECOVERY_TP') ? 'bg-cyan-900/30 border-cyan-700/40' :
                        'bg-slate-800/40 border-cyan-700/30'
                      }`}
                    >
                      <Typography variant="subtitle2" className="font-bold text-cyan-100 mb-1">
                        {action.id}. {action.action.replace(/_/g, ' ')}
                      </Typography>
                      
                      <Box className="text-sm space-y-1 ml-2">
                        {action.trigger && (
                          <Typography variant="caption" className="text-slate-400 block">
                            ▸ Trigger: {action.trigger}
                          </Typography>
                        )}
                        {action.outcome && (
                          <Typography variant="caption" className="text-slate-300 block font-medium">
                            ▸ Outcome: {action.outcome}
                          </Typography>
                        )}
                        {action.saved_capital && (
                          <Typography variant="caption" className="text-emerald-300 block font-bold">
                            💰 Saved: ${action.saved_capital.toFixed(0)} (buying below grid!)
                          </Typography>
                        )}
                        {action.enhanced_profit && (
                          <Typography variant="caption" className="text-emerald-400 block font-bold">
                            🎉 Enhanced Profit: ${action.enhanced_profit.toFixed(0)} extra!
                          </Typography>
                        )}
                        {action.brain_function && (
                          <Typography variant="caption" className="text-purple-300 block font-mono text-xs">
                            🧠 {action.brain_function}
                          </Typography>
                        )}
                      </Box>
                    </Box>
                  ))}
                </Box>
              </CardContent>
            </Card>
          )}
        </Box>
      )}

      {/* Logic Conflicts Warning (if any detected) */}
      {strategy.logic_conflicts && strategy.logic_conflicts.length > 0 && (
        <Alert severity="error" className="mb-4 border-l-4 border-red-500">
          <Box className="flex items-center gap-2 mb-2">
            <Warning />
            <Typography variant="h6" className="font-bold">
              ⚠️ Logic Conflicts Detected in Bot Brain:
            </Typography>
          </Box>
          {strategy.logic_conflicts.map((conflict, idx) => (
            <Box key={idx} className="mb-2 ml-4">
              <Typography variant="body2" className="font-bold">
                [{conflict.severity}] {conflict.type}
              </Typography>
              <Typography variant="caption" className="block text-slate-300">
                {conflict.description}
              </Typography>
              <Typography variant="caption" className="block text-cyan-300">
                → {conflict.recommendation}
              </Typography>
            </Box>
          ))}
        </Alert>
      )}


      {/* Next Order Details */}
      {decision_tree?.next_order && (
        <Card className="border border-emerald-600/50 bg-gradient-to-br from-emerald-900/20 to-slate-900">
          <CardContent>
            <Typography variant="h6" className="font-semibold text-emerald-100 mb-3 flex items-center gap-2">
              <TrendingUp className="text-emerald-400" />
              Next Order Details
            </Typography>
            
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <Box className="p-3 rounded-lg bg-slate-800/50 border border-emerald-700/30">
                <Typography variant="caption" className="text-slate-400">Type</Typography>
                <Typography variant="body1" className="font-bold text-emerald-100">
                  {decision_tree.next_order.type}
                </Typography>
              </Box>
              <Box className="p-3 rounded-lg bg-slate-800/50 border border-emerald-700/30">
                <Typography variant="caption" className="text-slate-400">Entry Price</Typography>
                <Typography variant="body1" className="font-bold text-emerald-100">
                  ${decision_tree.next_order.price?.toLocaleString()}
                </Typography>
              </Box>
              <Box className="p-3 rounded-lg bg-slate-800/50 border border-emerald-700/30">
                <Typography variant="caption" className="text-slate-400">TP Target</Typography>
                <Typography variant="body1" className="font-bold text-emerald-100">
                  ${decision_tree.next_order.tp_target?.toLocaleString()}
                </Typography>
              </Box>
              <Box className="p-3 rounded-lg bg-slate-800/50 border border-emerald-700/30">
                <Typography variant="caption" className="text-slate-400">Profit Target</Typography>
                <Typography variant="body1" className="font-bold text-emerald-100">
                  ${(decision_tree.next_order.tp_target - decision_tree.next_order.price)?.toLocaleString()}
                </Typography>
              </Box>
            </div>
            
            <Box className="mt-4 p-3 rounded-lg bg-slate-800/50 border border-emerald-700/30">
              <Typography variant="caption" className="text-slate-400 block mb-1">Reason</Typography>
              <Typography variant="body2" className="text-slate-300">
                {decision_tree.next_order.reason}
              </Typography>
            </Box>
          </CardContent>
        </Card>
      )}

      {/* Future Scenarios */}
      {decision_tree?.future_scenarios && decision_tree.future_scenarios.length > 0 && (
        <Card className="border border-slate-700 bg-slate-900">
          <CardContent>
            <Typography variant="h6" className="font-semibold text-slate-100 mb-3 flex items-center gap-2">
              <Timeline className="text-violet-400" />
              Future Scenarios
            </Typography>
            <Typography variant="body2" className="text-slate-400 mb-4">
              What the bot will do under different market conditions
            </Typography>
            
            <div className="space-y-3">
              {decision_tree.future_scenarios.map((scenario, index) => (
                <Box 
                  key={index}
                  className="p-3 rounded-lg bg-slate-800/50 border border-slate-700 hover:border-violet-600/50 transition-colors"
                >
                  <Typography variant="body2" className="font-semibold text-violet-300 mb-1">
                    {scenario.condition}
                  </Typography>
                  <Typography variant="body2" className="text-slate-300 mb-2">
                    → <strong>{scenario.action}</strong>
                  </Typography>
                  <Typography variant="caption" className="text-slate-400">
                    Result: {scenario.outcome}
                  </Typography>
                </Box>
              ))}
            </div>
          </CardContent>
        </Card>
      )}

      {/* Next Actions Sequence */}
      {next_actions && next_actions.length > 0 && (
        <Card className="border border-slate-700 bg-slate-900">
          <CardContent>
            <Typography variant="h6" className="font-semibold text-slate-100 mb-3 flex items-center gap-2">
              <Zap className="text-cyan-400" />
              Predicted Action Sequence
            </Typography>
            <Typography variant="body2" className="text-slate-400 mb-4">
              The next actions the bot will take (in order)
            </Typography>
            
            <div className="relative">
              {/* Timeline connector */}
              <div className="absolute left-6 top-8 bottom-8 w-0.5 bg-gradient-to-b from-cyan-500 via-violet-500 to-transparent"></div>
              
              <div className="space-y-4">
                {next_actions.map((action, index) => (
                  <Box key={index} className="relative flex items-start gap-4">
                    {/* Sequence number */}
                    <Box 
                      className="relative z-10 flex items-center justify-center w-12 h-12 rounded-full font-bold text-sm"
                      style={{
                        background: 'linear-gradient(135deg, #06b6d4 0%, #8b5cf6 100%)',
                        color: '#fff'
                      }}
                    >
                      {action.sequence}
                    </Box>
                    
                    {/* Action details */}
                    <Box className="flex-1 p-3 rounded-lg bg-slate-800/50 border border-slate-700">
                      <Typography variant="body2" className="font-semibold text-slate-100 mb-1">
                        {action.action}
                      </Typography>
                      <Typography variant="caption" className="text-slate-400 block mb-1">
                        <strong>Trigger:</strong> {action.trigger}
                      </Typography>
                      <Typography variant="caption" className="text-slate-500">
                        <strong>Timeframe:</strong> {action.timeframe}
                      </Typography>
                    </Box>
                  </Box>
                ))}
              </div>
            </div>
          </CardContent>
        </Card>
      )}

      {/* Blocking Conditions */}
      {decision_tree?.blocking_conditions && decision_tree.blocking_conditions.length > 0 && (
        <Alert severity="warning" className="border border-amber-600/50">
          <Typography variant="body2" className="font-semibold mb-2">
            ⚠️ Trading Currently Blocked By:
          </Typography>
          <ul className="list-disc list-inside space-y-1">
            {decision_tree.blocking_conditions.map((condition, index) => (
              <li key={index} className="text-sm">
                {condition}
              </li>
            ))}
          </ul>
        </Alert>
      )}

      {/* Allowed Actions */}
      {decision_tree?.allowed_actions && decision_tree.allowed_actions.length > 0 && (
        <Box className="p-4 rounded-lg bg-emerald-900/10 border border-emerald-700/30">
          <Typography variant="body2" className="font-semibold text-emerald-300 mb-2">
            ✅ Allowed Actions:
          </Typography>
          <ul className="list-disc list-inside space-y-1">
            {decision_tree.allowed_actions.map((action, index) => (
              <li key={index} className="text-sm text-slate-300">
                {action}
              </li>
            ))}
          </ul>
        </Box>
      )}

      {/* Auto-refresh indicator */}
      <Box className="flex items-center justify-center gap-2 py-2">
        <CircularProgress size={12} className="text-slate-600" />
        <Typography variant="caption" className="text-slate-500">
          Auto-refreshing every 5 seconds with live market data
        </Typography>
      </Box>
    </div>
  );
};

export default BotStrategyPanel;

