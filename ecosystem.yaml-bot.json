{
  "apps": [
    {
      "name": "gridbot-yaml",
      "script": "launch_bot.py",
      "interpreter": "python3",
      "cwd": "/Users/ssr/Projects/WorkingBot",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "1G",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "NODE_ENV": "production"
      },
      "error_file": "./logs/gridbot-yaml-error.log",
      "out_file": "./logs/gridbot-yaml-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "kill_timeout": 5000
    }
  ]
}
