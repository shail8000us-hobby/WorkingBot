    async def _check_cooldown(self) -> bool:
        """
        Check if cooldown period has elapsed since last order.
        
        Returns:
            True if ready to place order, False if in cooldown
        """
        if self.cooldown_seconds <= 0:
            return True
        
        elapsed = time.time() - self._last_order_time
        if elapsed < self.cooldown_seconds:
            remaining = self.cooldown_seconds - elapsed
            log.debug(f"Cooldown active: {remaining:.1f}s remaining")
            return False
        
        return True
    
    async def _read_guardian_signal(self) -> tuple[str, str]:
        """
        Read Guardian's GO/STOP signal from SQL database.
        
        Guardian monitors ALL risk:
        - Volatility (IV/RV/spread)
        - Loss limits (max_account_loss_inr)
        - Position size (max_position_size)
        - Liquidation distance (min_liquidation_distance_inr)
        
        Returns:
            (signal, reason) - 'GO'/'STOP' and reason string
        """
        try:
            import sqlite3
            from pathlib import Path
            
            db_path = Path('gridbot_events.db')
            
            if not db_path.exists():
                log.warning("Guardian database not found, assuming GO")
                return 'GO', 'Guardian database not yet created'
            
            conn = sqlite3.connect(str(db_path))
            cursor = conn.cursor()
            
            # Get latest Guardian signal
            cursor.execute('''
                SELECT signal, reason, timestamp
                FROM guardian_signals
                ORDER BY timestamp DESC
                LIMIT 1
            ''')
            
            result = cursor.fetchone()
            conn.close()
            
            if not result:
                log.warning("No Guardian signal found, assuming GO")
                return 'GO', 'No Guardian signal published yet'
            
            signal, reason, timestamp = result
            
            # Check signal age (Guardian publishes every 5s)
            import time
            signal_age = time.time() - timestamp
            if signal_age > 30:  # 30 seconds = 6 missed cycles
                log.warning(f"Guardian signal is stale ({signal_age:.0f}s old), assuming STOP for safety")
                return 'STOP', f'Guardian signal stale ({signal_age:.0f}s old)'
            
            return signal, reason
            
        except Exception as e:
            log.error(f"Error reading Guardian signal: {e}")
            # On error, assume STOP for safety
            return 'STOP', f'Guardian signal read error: {str(e)}'
    
