    async def _check_startup_opportunistic_recovery(self) -> bool:
        """Check for missed grid levels at startup and fill opportunistically with full safety checks.
        
        Returns:
            bool: True if recovery was executed, False otherwise
        """
        # Startup opportunistic recovery disabled - standard grid gap-fill handles missed levels
        return False
        
        try:
            state = await self.position_actor.ask("GET_STATE", {}, timeout=3.0)
            has_positions = len(state.get("open_tranches", [])) > 0
            
            if has_positions:
                log.debug("Skipping startup recovery - positions already exist")
                return False
            
            # CRITICAL: Run comprehensive safety check BEFORE attempting recovery
            # This ensures recovery respects ALL safety limits (account loss, margin, volatility, etc.)
            can_proceed, safety_reason = await self._comprehensive_safety_check("startup opportunistic recovery check")
            if not can_proceed:
                log.warning(f"Startup recovery blocked by safety: {safety_reason.split(chr(10))[0]}")
                return False
            
            if self.mode == "LONG":
                first_grid_level = self.grid_calc.ref - self.grid_calc.step
            else:
                first_grid_level = self.grid_calc.ref + self.grid_calc.step
            
            missed_levels = []
            
            if self.mode == "LONG" and self.current_price < first_grid_level:
                check_price = first_grid_level
                while check_price > self.current_price and len(missed_levels) < self._startup_opportunistic_max:
                    if check_price >= self.grid_calc.lower:
                        missed_levels.append(check_price)
                    check_price -= self.grid_calc.step
            
            elif self.mode == "SHORT" and self.current_price > first_grid_level:
                check_price = first_grid_level
                while check_price < self.current_price and len(missed_levels) < self._startup_opportunistic_max:
                    if check_price <= self.grid_calc.upper:
                        missed_levels.append(check_price)
                    check_price += self.grid_calc.step
            
            if missed_levels:
                log.info(f"Startup recovery detected - {len(missed_levels)} missed levels")
                log.info(f"Current price: ${self.current_price:,.2f}, First grid: ${first_grid_level:,.0f}")
                
                # Notify PositionActor that recovery is starting
                await self.position_actor.tell("RECOVERY_STARTED", {"recovery_type": "startup"})
                
                await self._execute_startup_recovery(missed_levels)
                return True  # Recovery executed
            else:
                log.debug("No missed levels detected - normal startup")
                return False  # No recovery needed
        
        except Exception as e:
            log.error(f"Error in startup recovery check: {e}")
            return False  # Error = no recovery
    
    async def _execute_startup_recovery(self, grid_levels: List[float]) -> None:
        """Execute startup recovery with full safety checks before each order.
        
        SAFETY INTEGRATION:
        - Calls _comprehensive_safety_check() BEFORE each individual order
        - This ensures EVERY recovery order passes all safety limits
        - If ANY check fails, recovery stops immediately
        - Prevents recovery from violating account loss, margin, or volatility limits
        """
        if not grid_levels:
            return
        
        filled_positions = []
        log.info(f"Executing startup recovery for {len(grid_levels)} levels")
        
        for i, grid_level in enumerate(grid_levels):
            try:
                # CRITICAL: Safety check before EACH order (not just once at start)
                can_proceed, reason = await self._comprehensive_safety_check(f"startup recovery #{i+1}")
                if not can_proceed:
                    log.warning(f"Recovery order {i+1} blocked by safety: {reason.split(chr(10))[0]}")
                    break
                
                side = 'buy' if self.mode == 'LONG' else 'sell'
                log.info(f"Recovery {i+1}/{len(grid_levels)}: Placing {side.upper()} MARKET order for grid ${grid_level:,.0f}")
                
                # Use correct message type based on side
                message_type = "PLACE_BUY" if side == 'buy' else "PLACE_SELL"
                order_result = await self.order_actor.ask(
                    message_type,
                    {
                        "price": grid_level,  # Reference price for TP calculation
                        "size": self.lot_size,
                        "order_type": "market",  # CRITICAL: Market order for immediate execution
                        "order_purpose": "recovery"  # Mark as recovery order
                    },
                    timeout=15.0
                )
                
                if order_result.get("status") != "ok":
                    log.error(f"Market order failed: {order_result.get('error', 'Unknown error')}")
                    continue
                
                order_id = order_result.get("order_id")
                log.info(f"Recovery order {order_id} placed - waiting for WebSocket fill event...")
                
                # CRITICAL: Wait for WebSocket to process fill (NOT REST API polling)
                # Market orders fill instantly, WebSocket delivers fill within 1-3 seconds
                await asyncio.sleep(3.0)
                
                # Check if position was added via WebSocket fill handler
                state_after = await self.position_actor.ask("GET_STATE", {})
                positions_after = state_after.get("open_tranches", [])
                
                # Find the newly added position (if any)
                new_position = None
                for pos in positions_after:
                    if pos.get('position_id') == str(order_id):
                        new_position = pos
                        break
                
                if not new_position:
                    log.error(f"Recovery order {order_id} - position not found in state after 3s")
                    log.error("WebSocket fill may have been missed or delayed")
                    continue
                
                fill_price = new_position.get('actual_entry') or new_position.get('entry_price')
                log.info(f"✅ Recovery {i+1}/{len(grid_levels)} filled @ ${fill_price:,.2f}")
                
                # Calculate TP using grid calculator (same as normal positions)
                if self.mode == 'LONG':
                    tp_price = grid_level + self.grid_calc.step
                else:
                    tp_price = grid_level - self.grid_calc.step
                
                saved_capital = abs(grid_level - fill_price)
                log.info(f"Filled @ ${fill_price:,.2f} | TP target: ${tp_price:,.0f} | Saved: ${saved_capital:,.2f}")
                
                # CRITICAL: Use PositionActor expected format
                # Match format from fill_processing_saga.py
                position_data = {
                    'position_id': str(order_id),  # Required by PositionActor
                    'entry_price': grid_level,     # Grid level (for TP calculation)
                    'tp_price': tp_price,          # Required by PositionActor
                    'size': self.lot_size,         # Required by PositionActor
                    'actual_entry': fill_price,    # Real fill price (for PnL tracking)
                    'is_opportunistic': True,      # Flag for WebUI display
                    'saved_capital': saved_capital # Extra profit from better entry
                }
                
                # Add position to PositionActor (no await needed for tell)
                await self.position_actor.tell("ADD_POSITION", position_data)
                log.debug(f"Position {position_data['position_id']} added to PositionActor")
                
                # Place TP order (TP price already in position_data)
                tp_success = await self._place_opportunistic_tp(position_data)
                
                if tp_success:
                    filled_positions.append(position_data)
                    log.info(f"✅ Recovery position {i+1} complete with TP protection")
                else:
                    log.critical(f"CRITICAL: Position {position_data['position_id']} has NO TP - manual intervention required")
                    # Send Telegram alert for unprotected position
                    try:
                        from bot.utils.notifier import TelegramNotifier
                        notifier = TelegramNotifier()
                        await notifier.send_message(
                            f"🚨 CRITICAL: Opportunistic recovery position has NO TP!\n"
                            f"Position ID: {position_data['position_id']}\n"
                            f"Entry: ${fill_price:,.2f}\n"
                            f"Expected TP: ${tp_price:,.0f}\n"
                            f"ACTION REQUIRED: Manually place TP order!"
                        )
                    except Exception as e:
                        log.debug(f"Telegram notification failed: {e}")
                        pass  # Telegram not critical
                
                if i < len(grid_levels) - 1:
                    await asyncio.sleep(self._recovery_execution_delay_ms / 1000.0)
            
            except Exception as e:
                log.error(f"Error executing recovery for level ${grid_level:,.0f}: {e}")
        
        if filled_positions:
            total_saved = sum(p['saved_capital'] for p in filled_positions)
            log.info(f"Startup recovery complete: {len(filled_positions)} positions, ${total_saved:,.2f} saved")
            # Mark bot as started (even if recovery partial - positions exist)
            self._initial_order_placed = True
        else:
            log.warning("Startup recovery completed with 0 fills")
            # Still mark as started to allow normal grid trading
            self._initial_order_placed = True
    
    async def _place_opportunistic_tp(self, position_data: Dict[str, Any]) -> bool:
        """Place TP order for opportunistic position.
        
        Args:
            position_data: Position dict with position_id, tp_price, size
            
        Returns:
            bool: True if TP placed successfully, False otherwise
        """
        try:
            tp_price = position_data['tp_price']
            position_id = position_data['position_id']
            
            log.debug(f"Placing TP for position {position_id} @ ${tp_price:,.0f}")
            
            # Use OrderActor PLACE_TP which handles reduce_only and side automatically
            result = await self.order_actor.ask("PLACE_TP", {
                "price": tp_price,
                "size": position_data['size'],
                "position_id": position_id  # Link TP to position
            }, timeout=10.0)
            
            if result.get("status") == "ok":
                tp_order_id = result.get("order_id")
                log.info(f"TP placed @ ${tp_price:,.0f} (ID: {tp_order_id})")
                
                # Update PositionActor with TP order ID (same as normal positions)
                await self.position_actor.tell("UPDATE_POSITION_TP", {
                    "position_id": position_id,
                    "tp_order_id": tp_order_id
                })
                
                # Store TP info in position_data for local tracking
                position_data['tp_order_id'] = tp_order_id
                position_data['protected'] = True
                return True
            else:
                log.error(f"TP placement failed: {result.get('error', 'Unknown error')}")
                return False
                
        except Exception as e:
            log.error(f"Error placing TP: {e}")
            return False
    
    
