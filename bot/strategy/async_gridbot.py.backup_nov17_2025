    async def _export_guardian_health(self, state: Dict, snapshot: Dict) -> None:
        """
        Export health data for Guardian bot monitoring.
        Guardian bot reads this file to monitor bot health and enforce risk limits.
        """
        try:
            health_file = Path("bot/reports/guardian_health.json")
            health_file.parent.mkdir(parents=True, exist_ok=True)
            
            # Calculate total PnL from all open positions
            total_pnl = 0
            total_loss = 0
            open_tranches = state.get("open_tranches", [])
            
            for position in open_tranches:
                entry_price = position.get("entry_price", 0)
                size = position.get("size", 0)
                current_price = self._last_price if hasattr(self, '_last_price') else entry_price
                
                # Calculate PnL based on mode
                if self.mode == "LONG":
                    pnl = (current_price - entry_price) * size
                else:  # SHORT
                    pnl = (entry_price - current_price) * size
                
                total_pnl += pnl
                if pnl < 0:
                    total_loss += abs(pnl)
            
            # Build health data structure expected by Guardian
            health_data = {
                "timestamp": time.time(),
                "pid": os.getpid(),
                "uptime_seconds": int(time.time() - self._start_time),
                "status": "ok",  # Guardian controls halt state
                "monitoring": {
                    "position_count": len(open_tranches),
                    "total_pnl_inr": total_pnl,
                    "total_loss_inr": total_loss,
                    "pending_orders": 1 if (state.get("pending_buy") or state.get("pending_sell")) else 0,
                    "sagas_active": snapshot["metrics"]["sagas"].get("active_sagas", 0),
                    "sagas_failed": self._sagas_failed
                },
                "liquidation": {
                    "margin_utilization": None,  # TODO: Fetch from exchange
                    "distance_to_liquidation": None,  # TODO: Calculate
                    "current_mtm_inr": total_pnl
                },
                "safety": {
                    "guardian_monitoring": True,  # Guardian monitors all risk
                    "signal_based_trading": True  # Bot reads Guardian GO/STOP signal
                }
            }
            
            # Write health file (async I/O)
            async with aiofiles.open(health_file, "w") as f:
                await f.write(json.dumps(health_data, indent=2))
            
        except Exception as e:
            log.debug(f"Guardian health export error: {e}")
    
    async def _check_memory_usage(self) -> None:
        """Check memory usage and log warnings if excessive."""
        try:
            import psutil
            process = psutil.Process(os.getpid())
            mem_info = process.memory_info()
            mem_mb = mem_info.rss / 1024 / 1024
            
            # Warn if memory exceeds 400 MB
            if mem_mb > 400:
                log.warning(f"⚠️  High memory usage: {mem_mb:.1f} MB")
                
                # Trigger garbage collection if memory is high
                if mem_mb > 450:
                    import gc
                    gc.collect()
                    log.info("   Triggered garbage collection")
        except Exception as e:
            log.debug(f"Memory check error: {e}")
    
    async def _check_websocket_health(self) -> None:
        """
        Check WebSocket connection health using proper manager API.
        
        NOV 13 v2: Fixed to use _ws_is_alive() wrapper and proper reconnection flow.
        Prevents AttributeError on .closed/.connected/.open attributes.
        """
        try:
            # Check if WebSocket manager exists
            if not self.ws_manager:
                log.warning("⚠️  WebSocket manager not initialized")
                return
            
            # Use the proper is_connected property (uses _ws_is_alive internally)
            if not self.ws_manager.is_connected:
                log.warning(f"⚠️  WebSocket not connected (state: {self.ws_manager.state.value})")
                
                # Only attempt reconnect if in DISCONNECTED state (not CONNECTING/RECONNECTING)
                if (self.ws_manager.state.value == "disconnected" and 
                    not self.ws_manager._reconnecting):
                    log.error("❌ WebSocket disconnected - triggering reconnect...")
                    try:
                        # Don't call connect() directly - trigger reconnect which handles cleanup
                        asyncio.create_task(self.ws_manager._handle_reconnect())
                    except Exception as reconnect_error:
                        log.error(f"Reconnect trigger failed: {reconnect_error}")
                return
            
            # Check time since last price update (data flow health)
            if self._last_price_update > 0:
                time_since_update = time.time() - self._last_price_update
                
                # Warn if no update for > 35 seconds (Delta heartbeat is 30s + 5s buffer)
                if time_since_update > 35:
                    log.warning(f"⚠️  WebSocket starvation: {time_since_update:.1f}s since last price update")
                    log.warning("   Delta heartbeat threshold: 30s + 5s buffer = 35s")
                    
                    # If > 60 seconds, WebSocket is likely stalled - force reconnect
                    if time_since_update > 60:
                        log.error("❌ WebSocket appears dead (no data for 60s) - forcing reconnect...")
                        # Trigger full reconnection (not just connect)
                        if not self.ws_manager._reconnecting:
                            asyncio.create_task(self.ws_manager._handle_reconnect())
        except Exception as e:
            log.error(f"WebSocket health check error: {e}", exc_info=True)
    
