    async def _cancel_pending_orders_on_shutdown(self) -> None:
        """
        Cancel pending entry orders on shutdown.
        
        CRITICAL POLICY (NOV 14):
        -------------------------
        On bot shutdown, we must cancel pending ENTRY orders (BUY/SELL) that haven't filled yet.
        These are stored in position_actor.state["pending_buy"] / ["pending_sell"].
        
        WHY?
        - Pending entry orders are speculative - they may fill after bot stops
        - This creates orphaned positions without TP protection
        - Bot won't be running to place TP orders for these fills
        
        WHAT WE PRESERVE:
        - Executed positions (already in open_tranches) - these stay open
        - TP orders (reduce_only=True) - these protect existing positions
        - Manual positions/orders - never touched by bot
        
        WHAT WE CANCEL:
        - Pending BUY orders (LONG mode entry orders)
        - Pending SELL orders (SHORT mode entry orders)
        
        NOTE: We do NOT cancel TP orders because:
        1. They are reduce_only (can only close positions)
        2. They protect existing positions from loss
        3. User may want to keep positions open with TP protection
        """
        try:
            log.info("=" * 70)
            log.info("🧹 SHUTDOWN: Cancelling pending entry orders...")
            log.info("=" * 70)
            
            # Get state from position actor (contains pending orders)
            try:
                state = await asyncio.wait_for(
                    self.position_actor.ask("GET_STATE", {}),
                    timeout=3.0
                )
            except asyncio.TimeoutError:
                log.warning("⚠️  Timeout getting position state - skipping cancellation")
                return
            except Exception as e:
                log.warning(f"⚠️  Error getting position state: {e} - skipping cancellation")
                return
            
            if not state:
                log.info("✅ No state available")
                return
            
            pending_buy = state.get("pending_buy")
            pending_sell = state.get("pending_sell")
            
            if not pending_buy and not pending_sell:
                log.info("✅ No pending entry orders to cancel")
                return
            
            cancelled_count = 0
            
            # Cancel pending BUY order (LONG mode entry)
            if pending_buy:
                order_id = pending_buy.get("order_id")
                price = pending_buy.get("price")
                
                if order_id:
                    # Convert price to float for formatting (may be string)
                    try:
                        price_float = float(price) if price else 0
                        log.info(f"🗑️  Cancelling pending BUY @ ${price_float:,.0f} (Order: {order_id})")
                    except (ValueError, TypeError):
                        log.info(f"🗑️  Cancelling pending BUY @ {price} (Order: {order_id})")
                    
                    try:
                        # Cancel via order actor
                        result = await self.order_actor.ask(
                            "CANCEL_ORDER",
                            {"order_id": order_id},
                            timeout=10.0
                        )
                        
                        if result.get("status") == "ok":
                            if result.get("already_gone"):
                                log.info(f"   ℹ️  Order already filled/cancelled by exchange")
                            else:
                                log.info(f"   ✅ Cancelled pending BUY order")
                                human_log.order_cancelled(order_id)
                            cancelled_count += 1
                            
                            # Clear from position actor
                            await self.position_actor.tell("CLEAR_PENDING_BUY", {})
                        else:
                            error_msg = result.get('error', 'Unknown error')
                            error_type = result.get('error_type', 'Unknown')
                            log.error(f"   ❌ FAILED to cancel BUY order: {error_type}: {error_msg}")
                            log.error(f"   ⚠️  ORDER {order_id} MAY STILL BE ACTIVE ON EXCHANGE!")
                    except Exception as e:
                        log.error(f"   ❌ Exception during BUY order cancellation: {e}")
                        log.error(f"   ⚠️  ORDER {order_id} MAY STILL BE ACTIVE ON EXCHANGE!")
            
            # Cancel pending SELL order (SHORT mode entry)
            if pending_sell:
                order_id = pending_sell.get("order_id")
                price = pending_sell.get("price")
                
                if order_id:
                    # Convert price to float for formatting (may be string)
                    try:
                        price_float = float(price) if price else 0
                        log.info(f"🗑️  Cancelling pending SELL @ ${price_float:,.0f} (Order: {order_id})")
                    except (ValueError, TypeError):
                        log.info(f"🗑️  Cancelling pending SELL @ {price} (Order: {order_id})")
                    
                    try:
                        # Cancel via order actor
                        # Delta Exchange can take up to 15s to process order cancellations
                        result = await self.order_actor.ask(
                            "CANCEL_ORDER",
                            {"order_id": order_id},
                            timeout=15.0
                        )
                        
                        if result.get("status") == "ok":
                            if result.get("already_gone"):
                                log.info(f"   ℹ️  Order already filled/cancelled by exchange")
                            else:
                                log.info(f"   ✅ Cancelled pending SELL order")
                                human_log.order_cancelled(order_id)
                            cancelled_count += 1
                            
                            # Clear from position actor
                            await self.position_actor.tell("CLEAR_PENDING_SELL", {})
                        else:
                            error_msg = result.get('error', 'Unknown error')
                            error_type = result.get('error_type', 'Unknown')
                            log.error(f"   ❌ FAILED to cancel SELL order: {error_type}: {error_msg}")
                            log.error(f"   ⚠️  ORDER {order_id} MAY STILL BE ACTIVE ON EXCHANGE!")
                    except Exception as e:
                        log.error(f"   ❌ Exception during SELL order cancellation: {e}")
                        log.error(f"   ⚠️  ORDER {order_id} MAY STILL BE ACTIVE ON EXCHANGE!")
            
            # Summary
            open_positions = len(state.get("open_tranches", []))
            
            if cancelled_count > 0:
                log.info("=" * 70)
                log.info(f"✅ Cancelled {cancelled_count} pending entry order(s)")
                log.info(f"📊 Preserving {open_positions} open position(s) with TP protection")
                log.info("=" * 70)
            else:
                log.info("=" * 70)
                log.info(f"ℹ️  No pending entry orders to cancel")
                log.info(f"📊 Preserving {open_positions} open position(s) with TP protection")
                log.info("=" * 70)
        
        except Exception as e:
            log.error(f"❌ Error during pending order cancellation on shutdown: {e}")
            import traceback
            log.error(traceback.format_exc())
    
