    async def _verify_tp_protection(self, state: Dict[str, Any], exchange_orders: List[Dict]) -> None:
        """
        Verify all positions have TP protection.
        Place emergency TPs if missing.
        """
        try:
            positions = state.get("open_tranches", [])
            
            if not positions:
                log.info("✅ [RECONCILIATION] No positions to verify")
                return
            
            # Build map of position_id -> TP order
            tp_orders = {}
            for order in exchange_orders:
                if order.get("order_type") == "limit_order":
                    # Check if this is a TP order (opposite side of position)
                    product_id = order.get("product_id")
                    # We'd need to correlate with positions - simplified for now
                    pass
            
            # Check each position
            unprotected_positions = []
            
            for pos in positions:
                tp_order_id = pos.get("tp_order_id")
                
                if not tp_order_id:
                    log.warning(f"⚠️ [RECONCILIATION] Position {pos.get('entry_order_id')} has no TP order ID!")
                    unprotected_positions.append(pos)
                    continue
                
                # Verify TP exists on exchange
                tp_exists = any(o.get("id") == tp_order_id or o.get("order_id") == tp_order_id 
                               for o in exchange_orders)
                
                if not tp_exists:
                    log.critical(f"🚨 [RECONCILIATION] Position {pos.get('entry_order_id')} TP order {tp_order_id} NOT FOUND on exchange!")
                    unprotected_positions.append(pos)
            
            # Place emergency TPs
            if unprotected_positions:
                log.critical(f"🚨 [RECONCILIATION] Found {len(unprotected_positions)} unprotected positions!")
                
                for pos in unprotected_positions:
                    try:
                        log.critical(f"   🚨 EMERGENCY: Placing TP NOW...")
                        await self._emergency_tp_placement(pos)
                    except Exception as e:
                        log.critical(f"   ❌ EMERGENCY TP FAILED: {e}")
            else:
                log.info("✅ [RECONCILIATION] All positions have TP protection")
                
        except Exception as e:
            log.error(f"❌ [RECONCILIATION] TP verification failed: {e}")
    
    async def _emergency_tp_placement(self, position: Dict[str, Any]) -> None:
        """
        Emergency TP placement for unprotected position.
        Last line of defense.
        """
        try:
            entry_price = position.get("entry_price")
            entry_order_id = position.get("entry_order_id")
            
            if not entry_price:
                log.critical(f"❌ [EMERGENCY TP] No entry price for position")
                return
            
            # Calculate TP price
            tp_price = self.grid_calc.compute_tp_price(entry_price, self.mode)
            
            log.critical(f"🚨 [EMERGENCY TP] Placing TP for position {entry_order_id}")
            log.critical(f"   Entry: {entry_price}, TP: {tp_price}")
            
            # Place TP via order actor (timeout=20s to allow for retries)
            result = await self.order_actor.ask("PLACE_TP", {
                "price": tp_price,
                "size": position.get("size", 1),
                "position_id": entry_order_id
            }, timeout=20.0)
            
            if result.get("status") == "ok":
                tp_order_id = result.get("order_id")
                log.critical(f"✅ [EMERGENCY TP] Placed: ID {tp_order_id}")
                
                # Update position with TP
                await self.position_actor.tell("UPDATE_POSITION_TP", {
                    "position_id": entry_order_id,
                    "tp_order_id": tp_order_id
                })
            else:
                log.critical(f"❌ [EMERGENCY TP] FAILED: {result.get('error')}")
                
        except Exception as e:
            log.critical(f"❌ [EMERGENCY TP] FAILED: {e}")
            raise
    
