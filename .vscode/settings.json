{
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        ".git": true,
        ".venv": true,
        ".ruff_cache": true,
        ".pytest_cache": true,
        ".mypy_cache": true,
        "bot/logs": true,
        "audit": true,
        "reports": true,
        "debugging": true,
        "gridbot_pro.egg-info": true,
        "workspace_snapshot.md": true,
        "LAST_ERROR.txt": true,
        "archive": true,
        "archive_hot": true,
        "backtest": true,
        "backtest_ui": true,
        "backtesting": true,
        "data": true,
        "database": true,
        "logs": true,
        "context_archive": true,
        ".claude": true,
        ".claw": true,
        ".cursor": true,
        ".ai": true,
        ".obsidian": true,
        ".qodo": true,
        ".specify": true,
        "node_modules": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/venv/**": true,
        "**/.venv/**": true,
        "**/__pycache__/**": true,
        "**/.pytest_cache/**": true,
        "**/.mypy_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/logs/**": true,
        "**/data/**": true,
        "**/database/**": true,
        "**/archive/**": true,
        "**/archive_hot/**": true,
        "**/backtest/**": true,
        "**/backtest_ui/**": true,
        "**/backtesting/**": true,
        "**/reports/**": true,
        "**/.claude/**": true,
        "**/.claw/**": true,
        "**/.cursor/**": true,
        "**/.ai/**": true,
        "**/.obsidian/**": true,
        "**/.qodo/**": true,
        "**/.specify/**": true,
        "**/context_archive/**": true
    },
    "explorer.compactFolders": false,
    "editor.unicodeHighlight.includeComments": true,
    "editor.unicodeHighlight.nonBasicASCII": true,
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    "workbench.browser.enableChatTools": true
}
