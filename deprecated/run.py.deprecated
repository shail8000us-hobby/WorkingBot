    SAFETY_CHECKS_ENABLED = True
except Exception:
    SAFETY_CHECKS_ENABLED = False

def envf(key, default):
    v = os.getenv(key, str(default))
    try:
        return type(default)(v)
    except Exception:
        return default

# Global flag for graceful shutdown
shutdown_requested = False

def signal_handler(signum, frame):
    """Handle Ctrl+C and other termination signals"""
    global shutdown_requested
    sig_name = signal.Signals(signum).name
    log.warning(f"Received {sig_name} - initiating graceful shutdown...")
    shutdown_requested = True
    # Also set it on the module itself to ensure it's visible
    import sys
    if 'bot.run' in sys.modules:
        sys.modules['bot.run'].shutdown_requested = True
    
    # Clean up single instance lock
    try:
        from bot.safety.single_instance_lock import cleanup_single_instance
        cleanup_single_instance()
    except Exception as e:
        log.warning(f"Failed to cleanup single instance lock: {e}")
    
    # Create shutdown flag file as backup
    try:
        with open('.bot_shutdown', 'w') as f:
            f.write('1')
    except Exception:
        pass

def main():
    # Clean up any leftover shutdown flag from previous run
    try:
        if os.path.exists('.bot_shutdown'):
            os.remove('.bot_shutdown')
    except Exception:
        pass
    
    # Single Instance Check: Prevent multiple trading bots from running
    try:
        from bot.safety.single_instance_lock import setup_single_instance_lock
        success, message = setup_single_instance_lock(trading_mode=trading_mode)
        if not success:
            log.critical("=" * 70)
            log.critical("🚫 MULTIPLE BOT INSTANCES DETECTED")
            log.critical("=" * 70)
            log.critical(message)
            log.critical("=" * 70)
            log.critical(f"Only ONE trading bot can run per mode ({trading_mode})!")
            log.critical("Please stop the existing bot before starting a new one.")
            log.critical("=" * 70)
            sys.exit(1)
        else:
            log.info(f"✅ Single instance check passed: {message}")
    except Exception as e:
        log.error(f"Single instance check failed: {e}")
        log.error("Continuing anyway, but this may cause conflicts...")
    
    # Register signal handlers for graceful shutdown
    signal.signal(signal.SIGINT, signal_handler)   # Ctrl+C
    signal.signal(signal.SIGTERM, signal_handler)  # kill command
    log.info("Signal handlers registered (Ctrl+C will gracefully stop the bot)")
    
    # Two-Man Rule: Check for pending config changes
    try:
        from bot.safety.config_guard import get_config_guard
        from pathlib import Path
        
        config_guard = get_config_guard(Path.cwd())
        
        if config_guard.enabled:
            # Load current config from environment (already loaded by dotenv)
            # We use os.getenv() instead of load_env() since env is already loaded
            current_config = {key: os.getenv(key, '') for key in config_guard.GUARDED_KEYS + config_guard.SAFETY_FEATURES}
            
            # Check for risky changes
            has_changes, message, changes = config_guard.check_config_changes(current_config)
            
            if has_changes:
                log.critical("=" * 70)
                log.critical("🛑 CONFIG CHANGE REQUIRES CONFIRMATION")
                log.critical("=" * 70)
                log.critical(message)
                log.critical("=" * 70)
                log.critical("Bot will NOT start until confirmed or timeout")
                log.critical("=" * 70)
                
                # Wait for confirmation or timeout
                log.info("Waiting for confirmation...")
                start_wait = time.time()
                
                while True:
                    confirmed, timed_out = config_guard.check_confirmation()
                    
                    if confirmed:
                        log.info("✅ Config change confirmed - proceeding with startup")
                        break
                    
                    if timed_out:
                        if config_guard.auto_revert:
                            log.error("❌ Confirmation timeout - changes REJECTED")
                            log.error("Bot will continue with PREVIOUS config (infinite uptime mode)")
                            log.error("To apply new config: fix settings, save, and confirm within 10min")
                            # DON'T EXIT - just continue with old config for infinite uptime
                            break
                        else:
                            log.warning("⚠️  Confirmation timeout - changes ACCEPTED by default")
                            break
                    
                    # Show waiting message every 30 seconds
                    elapsed = time.time() - start_wait
                    if int(elapsed) % 30 == 0:
                        remaining = config_guard.pending_change['timeout_sec'] - elapsed
                        log.info(f"Still waiting for confirmation... ({remaining//60:.0f}m {remaining%60:.0f}s remaining)")
                    
                    time.sleep(5)
    
    except Exception as e:
        log.warning(f"Config guard check failed (non-fatal): {e}")
    
    # Safety preflight checks
    if SAFETY_CHECKS_ENABLED:
        try:
            preflight(log)
        except SystemExit:
            log.error("Safety checks failed - bot will not start")
            return 2
        except Exception as e:
            log.warning(f"Safety check warning: {e}")

    # required inputs (now sourced from GRIDBOT_* which may come from grid_config.env)
    symbol   = os.getenv("GRIDBOT_SYMBOL", "BTC/USD:USD")
    lower    = envf("GRIDBOT_LOWER", 114000.0)
    upper    = envf("GRIDBOT_UPPER", 117000.0)
    step     = envf("GRIDBOT_STEP",  500.0)
    ref      = envf("GRIDBOT_REF",   116000.0)
    lot      = envf("GRIDBOT_LOT_SIZE", envf("GRIDBOT_LOT", 1))  # Check GRIDBOT_LOT_SIZE first, fallback to GRIDBOT_LOT
    max_open = envf("GRIDBOT_MAX_OPEN", 5)
    hb_sec   = envf("GRIDBOT_HB_SEC", 10)

    # WebSocket bot doesn't need CCXT - it uses native Delta client
    dc = DC(None)  # Legacy compatibility
    log.info(f"grid: online  symbol={symbol}  LOWER={lower}  UPPER={upper}  STEP={step}  REF={ref}  LOT={float(lot)}  max_open={max_open}")

    # Create diagnostic snapshot
    if DIAGNOSTICS_ENABLED:
        try:
            create_snapshot()
            log.info("Diagnostic snapshot created")
        except Exception as e:
            log.warning(f"Failed to create diagnostic snapshot: {e}")

    dc = DC(ex=None, ex_pub=None)
    
    # Initialize Liquidation Protection Monitors
    if os.getenv('LIQUIDATION_PROTECTION_ENABLED', 'true').lower() == 'true':
        try:
            # Initialize monitors with exchange operations
            # Note: We'll use ex (the exchange handle) directly since we don't have exchange_ops wrapper yet
            # The monitors will call ex.fetch_balance() and similar methods
            
            log.info("🛡️  Initializing liquidation protection monitors...")
            # Use integrated liquidation monitor instead of separate components
            liquidation_monitor = IntegratedLiquidationMonitor(config=os.environ)
            margin_monitor = liquidation_monitor
            distance_monitor = liquidation_monitor
            mtm_tracker = liquidation_monitor
            
            # Store in run module for access in strategy
            import bot.run as run_module
            run_module.margin_monitor = margin_monitor
            run_module.distance_monitor = distance_monitor
            run_module.mtm_tracker = mtm_tracker
            # volatility_monitor and volatility_tracker are already set earlier in the file
            if volatility_monitor:
                run_module.volatility_monitor = volatility_monitor
            if volatility_tracker:
                run_module.volatility_tracker = volatility_tracker
            
            log.info("")
            log.info(f"   Max margin utilization: {margin_monitor.margin_max}%")
            log.info(f"   Min liquidation distance: {distance_monitor.liquidation_distance_min}%")
            log.info("")
        except Exception as e:
            log.warning(f"  Liquidation protection initialization failed: {e}")
            log.warning(f"⚠️  Liquidation protection initialization failed: {e}")
            log.warning("Bot will continue without liquidation protection")
            margin_monitor = None
            distance_monitor = None
            mtm_tracker = None
    
    # Initialize Heartbeat Manager
    heartbeat = None
    if HEARTBEAT_AVAILABLE:
        heartbeat_enabled = os.getenv("ENABLE_HEARTBEAT", "true").lower() == "true"  # Re-enabled with DeltaClient
        if heartbeat_enabled:
            heartbeat_file = os.getenv("HEARTBEAT_FILE", ".heartbeat")
            heartbeat_interval = int(os.getenv("HEARTBEAT_UPDATE_INTERVAL", "5"))
            heartbeat = HeartbeatManager(
                heartbeat_file=heartbeat_file,
                update_interval=heartbeat_interval,
                enabled=True
            )
            heartbeat.start()
            log.info("💓 Heartbeat system activated")
        else:
            log.info("Heartbeat system disabled in config")
    
    # Create PID file for WebUI detection
    pid_file_path = Path("reports/bot.pid")
    pid_file_path.parent.mkdir(exist_ok=True)
    
    try:
        with open(pid_file_path, 'w') as f:
            f.write(str(os.getpid()))
        log.info(f"📝 Created PID file: {pid_file_path} (PID: {os.getpid()})")
    except Exception as e:
        log.warning(f"⚠️ Failed to create PID file: {e}")
    
    # Pass shutdown flag and heartbeat as module-level attributes for the strategy to check
    import bot.run as run_module
    run_module.shutdown_requested = shutdown_requested
    run_module.heartbeat = heartbeat
    
    async def run_async_bot():
        """Run async GridBot in proper async context."""
        # Get API credentials
        api_key = os.getenv("DELTA_API_KEY")
        api_secret = os.getenv("DELTA_API_SECRET")
        product_id = int(os.getenv("DELTA_PRODUCT_ID", "27"))
        testnet = os.getenv("DELTA_TESTNET", "false").lower() == "true"
        
        if not api_key or not api_secret:
            log.error("❌ DELTA_API_KEY and DELTA_API_SECRET must be set")
            sys.exit(1)
        
        # Determine trading mode from symbol
        mode = os.getenv("GRIDBOT_GRID_MODE", "LONG").upper()
        
        # Extract safety parameters
        max_loss = envf("MAX_ACCOUNT_LOSS_INR", 25000)
        vol_safety = os.getenv("VOLATILITY_SAFETY_ENABLED", "true").lower() == "true"
        vol_max_iv = envf("VOLATILITY_MAX_IV", 50)
        vol_max_rv = envf("VOLATILITY_MAX_RV", 55)
        vol_max_spread = envf("VOLATILITY_MAX_SPREAD", 20)
        confirmation_guard = os.getenv("CONFIRMATION_GUARD_ENABLED", "true").lower() == "true"
        circuit_breaker = os.getenv("CIRCUIT_BREAKER_ENABLED", "true").lower() == "true"
        liq_protection = os.getenv("LIQUIDATION_PROTECTION_ENABLED", "true").lower() == "true"
        
        # Extract order management parameters
        tag_prefix = os.getenv("GRIDBOT_TAG_PREFIX", "GBOT_")
        post_only_mode = os.getenv("GRIDBOT_POST_ONLY_MODE", "auto")
        cancel_all = os.getenv("GRIDBOT_CANCEL_ALL_ON_START", "0") == "1"
        cancel_scope = os.getenv("GRIDBOT_CANCEL_SCOPE", "tagged")
        adopt_untagged = os.getenv("GRIDBOT_ADOPT_UNTAGGED", "0") == "1"
        
        # Extract grid behavior parameters
        strict_grid = os.getenv("GRIDBOT_STRICT_GRID", "1") == "1"
        strict_start = os.getenv("GRIDBOT_STRICT_START", "1") == "1"
        seed_initial = envf("GRIDBOT_SEED_INITIAL_COUNT", 0)
        smart_gap_fill = os.getenv("SMART_GAP_FILL", "false").lower() == "true"
        rung_snap_mode = os.getenv("GRIDBOT_RUNG_SNAP_MODE", "below")
        
        # Extract timing parameters
        max_retries = envf("GRIDBOT_MAX_RETRIES", 3)
        retry_delay = envf("GRIDBOT_RETRY_DELAY", 2.0)
        cooldown_sec = envf("GRIDBOT_COOLDOWN_SECONDS", 30)
        
        # Extract conversion rate
        usd_to_inr = envf("USD_TO_INR_RATE", 85.0)
        
        log.info("Starting AsyncGridBot with async/await event loop")
        log.info(f"Symbol: {symbol}, Product ID: {product_id}, Mode: {mode}, Grid: {lower}-{upper}, Step: {step}")
        
        # Create async bot instance (inside async context)
        async_bot = AsyncGridBot(
            api_key=api_key,
            api_secret=api_secret,
            symbol=symbol.replace("/", "").replace(":USD", ""),  # BTCUSD format
            product_id=product_id,
            mode=mode,
            lower_price=lower,
            upper_price=upper,
            grid_step=step,
            ref_price=ref,  # Grid reference level
            tp_offset=step,  # Use step as TP offset
            max_positions=max_open,
            lot_size=lot,  # Contracts per order
            testnet=testnet,
            # Safety parameters
            max_account_loss_inr=max_loss,
            volatility_safety_enabled=vol_safety,
            volatility_max_iv=vol_max_iv,
            volatility_max_rv=vol_max_rv,
            volatility_max_spread=vol_max_spread,
            confirmation_guard_enabled=confirmation_guard,
            circuit_breaker_enabled=circuit_breaker,
            liquidation_protection_enabled=liq_protection,
            # Order management parameters
            tag_prefix=tag_prefix,
            post_only_mode=post_only_mode,
            cancel_all_on_start=cancel_all,
            cancel_scope=cancel_scope,
            adopt_untagged=adopt_untagged,
            # Grid behavior parameters
            strict_grid=strict_grid,
            strict_start=strict_start,
            seed_initial_count=seed_initial,
            smart_gap_fill=smart_gap_fill,
            rung_snap_mode=rung_snap_mode,
            # Timing parameters
            max_retries=max_retries,
            retry_delay=retry_delay,
            cooldown_seconds=cooldown_sec,
            # Conversion rate
            usd_to_inr_rate=usd_to_inr
        )
        
        # FIX NOV 14: Wrap start() with try/finally to ensure stop() is always called
        try:
            # Run async bot
            await async_bot.start()
        except (KeyboardInterrupt, asyncio.CancelledError):
            log.info("Shutdown signal received during bot operation")
        finally:
            # Always call stop() for graceful cleanup
            log.info("Calling stop() to cleanup...")
            try:
                await async_bot.stop()
            except Exception as e:
                log.error(f"Error during stop(): {e}")
                import traceback
                log.error(traceback.format_exc())
    
    try:
        # Run ASYNC GridBot (only mode available)
        asyncio.run(run_async_bot())
            
    except KeyboardInterrupt:
        log.warning("Interrupted by user (Ctrl+C)")
    finally:
        # Clean up PID file on shutdown
        try:
            if pid_file_path.exists():
                pid_file_path.unlink()
                log.info("🗑️ Removed PID file on shutdown")
        except Exception as e:
            log.warning(f"⚠️ Failed to remove PID file: {e}")
        
        # Stop heartbeat on shutdown
        if heartbeat:
            heartbeat.stop()
            log.info("💓 Heartbeat stopped")
    
    if shutdown_requested:
        log.info("Bot shutdown completed gracefully")
        return 0
    return 0

if __name__ == "__main__":
    sys.exit(main())
