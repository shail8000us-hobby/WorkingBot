<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tailscale.watchdog</string>
    
    <key>ProgramArguments</key>
    <array>
        <string>/Users/shailendrasinghrajawat/Documents/WorkingBot/tailscale/tailscale_watchdog.sh</string>
    </array>
    
    <!-- Run at load -->
    <key>RunAtLoad</key>
    <true/>
    
    <!-- Run every 60 seconds -->
    <key>StartInterval</key>
    <integer>60</integer>
    
    <!-- Also run on network state changes -->
    <key>WatchPaths</key>
    <array>
        <string>/Library/Preferences/SystemConfiguration</string>
    </array>
    
    <!-- Environment -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    
    <!-- Process settings -->
    <key>ProcessType</key>
    <string>Background</string>
    
    <key>StandardOutPath</key>
    <string>/opt/homebrew/var/log/tailscale_watchdog_output.log</string>
    
    <key>StandardErrorPath</key>
    <string>/opt/homebrew/var/log/tailscale_watchdog_error.log</string>
</dict>
</plist>
