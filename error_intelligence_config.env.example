# ========================================
# ERROR INTELLIGENCE SYSTEM CONFIGURATION
# ========================================

# Enable/disable error intelligence system
ERROR_COLLECTOR_ENABLED=true

# Database path for error storage
ERROR_DB_PATH=data/errors.db

# Allow destructive fixes (DANGEROUS - keep false in production)
ALLOW_DESTRUCTIVE_FIXES=false

# Log file paths to monitor
TRADING_BOT_LOG=bot.log
GUARDIAN_BOT_LOG=logs/guardian.log
HEALTH_BOT_LOG=logs/health.log

# Rate limiting
ERROR_RATE_LIMIT_WINDOW=60        # seconds
ERROR_RATE_LIMIT_MAX=100          # max errors per window
ERROR_BURST_THRESHOLD=10          # errors in 5 seconds = burst

# WebSocket push
ERROR_PUSH_WEBSOCKET=true

# Telegram notifications (optional - configure if using Telegram alerts)
# TELEGRAM_ERROR_NOTIFICATIONS=true
# TELEGRAM_BOT_TOKEN=your_token_here
# TELEGRAM_CHAT_ID=your_chat_id

# Escalation policies
# ERROR_ALERT_CRITICAL_IMMEDIATE=true
# ERROR_ALERT_HIGH_INTERVAL=600     # 10 minutes
# ERROR_ALERT_MEDIUM_INTERVAL=3600  # 1 hour
# ERROR_ALERT_LOW_NEVER=true
